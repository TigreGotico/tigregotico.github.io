    '<path d="M5 12h14M13 6l6 6-6 6"/>',
  home:
    '<path d="M3 10 12 3l9 7M5 9v11h14V9"/>',
};

const d = paths[name] ?? paths.spark;
---
<svg
  class={[className, name === "arrow" ? "i-arrow" : ""].filter(Boolean).join(" ")}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={d}
></svg>
