---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { ui, blogUI, blogSlug, type Locale } from '../../i18n';

interface Props {
  post: any;
  prev: any;
  next: any;
  locale: Locale;
}
const { post, prev, next, locale } = Astro.props;
const t = blogUI[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const blogHref = locale === 'en' ? `${base}/blog/` : `${base}/${locale}/blog/`;
const postHref = (p: any) =>
  locale === 'en' ? `${base}/blog/${blogSlug(p.id)}/` : `${base}/${locale}/blog/${blogSlug(p.id)}/`;

const { Content, remarkPluginFrontmatter } = await render(post);
const words: number = remarkPluginFrontmatter?.words ?? 0;
const readingMinutes = words ? Math.max(1, Math.round(words / 200)) : 0;
const ogImage = post.data.cover ? post.data.cover.src : post.data.coverExternal;

const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  inLanguage: ui[locale].lang,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  ...(post.data.updated ? { dateModified: post.data.updated.toISOString() } : {}),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@type': 'Organization', name: site.name },
  keywords: post.data.tags.join(', '),
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={ogImage}
  type="article"
  locale={locale}
  jsonLd={blogPostingLd}
  publishedTime={post.data.date.toISOString()}
  modifiedTime={post.data.updated?.toISOString()}
>
  <article class="mx-auto max-w-3xl">
    <p class="mb-8">
      <a class="inline-flex items-center gap-1 font-display text-xs uppercase tracking-[0.2em] text-primary hover:underline" href={blogHref}
        ><span class="arrow-flip inline-block">&larr;</span> {t.allPosts}</a
      >
    </p>
    <header class="space-y-5">
      <p class="flex flex-wrap items-center gap-x-2 font-display text-xs uppercase tracking-[0.18em] text-muted">
        <time datetime={post.data.date.toISOString()}>
          {
            post.data.date.toLocaleDateString(ui[locale].lang, {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </time>
        {post.data.author && <span>· {post.data.author}</span>}
        {readingMinutes > 0 && <span>· {readingMinutes} {t.minRead}</span>}
      </p>
      <h1 class="display-1" style="font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem);">
        {post.data.title}
      </h1>
      {
        post.data.tags.length > 0 && (
          <ul class="flex flex-wrap gap-1.5">
            {post.data.tags.map((tag: string) => (
              <li class="badge">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      (post.data.cover || post.data.coverExternal) && (
        <div class="relative mt-8 overflow-hidden rounded-2xl border border-border" style="box-shadow: var(--shadow-elevate);">
          {post.data.cover ? (
            <Image
              src={post.data.cover}
              alt={post.data.title}
              class="w-full"
              widths={[480, 800, 1200]}
              sizes="(max-width: 800px) 100vw, 800px"
            />
          ) : (
            <img
              src={post.data.coverExternal}
              alt={post.data.title}
              class="w-full"
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
      )
    }

    <hr class="rule-gradient my-10" />

    <div class="post-body">
      <Content />
    </div>

    {
      (prev || next) && (
        <nav class="mt-12 grid gap-4 border-t border-border pt-6 sm:grid-cols-2" aria-label={t.more}>
          {prev ? (
            <a href={postHref(prev)} class="card-hover group">
              <p class="font-display text-xs uppercase tracking-[0.2em] text-primary"><span class="arrow-flip inline-block">&larr;</span> {t.newer}</p>
              <p class="mt-2 display-3 text-base group-hover:text-primary">{prev.data.title}</p>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a href={postHref(next)} class="card-hover group sm:text-right">
              <p class="font-display text-xs uppercase tracking-[0.2em] text-primary">{t.older} <span class="arrow-flip inline-block">&rarr;</span></p>
              <p class="mt-2 display-3 text-base group-hover:text-primary">{next.data.title}</p>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>
