---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { site } from '../data/site';

const page = await getEntry('pages', 'contact');
const { Content } = await render(page!);

const subject = encodeURIComponent('Project inquiry — TigreGótico');
const body = encodeURIComponent(
  'Hi TigreGótico,\n\nI would like to discuss:\n- What I want to build:\n- Languages / platforms involved:\n- Timeline:\n\nThanks!'
);
const mailtoPrefilled = `mailto:${site.email}?subject=${subject}&body=${body}`;
---

<Base title={page!.data.title} description={page!.data.description}>
  <header class="mb-10 max-w-2xl">
    <p class="eyebrow mb-2">Say hello</p>
    <h1 class="font-serif text-4xl font-bold">Contact</h1>
    <p class="mt-3 text-muted">{page!.data.description}</p>
  </header>

  <div class="grid gap-8 lg:grid-cols-2">
    <article class="prose-content">
      <Content />
    </article>

    <div class="card h-max space-y-5">
      <div>
        <p class="text-sm text-muted">Email us directly</p>
        <a class="font-serif text-xl font-semibold text-primary hover:underline" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </div>
      <a class="btn-primary w-full" href={mailtoPrefilled}>
        Compose an inquiry
      </a>
      <p class="text-xs text-muted">
        No web forms, no trackers, no third-party backend — your message goes
        straight to our inbox.
      </p>
      <hr class="border-border" />
      <div>
        <p class="mb-2 text-sm font-semibold">Find our work</p>
        <ul class="space-y-1.5 text-sm">
          <li>
            <a class="text-primary hover:underline" href={site.socials.github} rel="noopener"
              >GitHub — github.com/TigreGotico</a
            >
          </li>
          <li>
            <a class="text-primary hover:underline" href={site.socials.huggingface} rel="noopener"
              >Hugging Face — huggingface.co/TigreGotico</a
            >
          </li>
          <li>
            <a class="text-primary hover:underline" href={site.socials.openvoiceos} rel="noopener"
              >OpenVoiceOS — openvoiceos.org</a
            >
          </li>
        </ul>
      </div>
    </div>
  </div>
</Base>
