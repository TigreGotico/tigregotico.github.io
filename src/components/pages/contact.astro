  },
  ru: {
    "eyebrow": "Поздоровайтесь",
    "title": "Контакты",
    "subject": "Запрос по проекту — TigreGótico",
    "body": "Здравствуйте, TigreGótico,\n\nЯ хотел бы обсудить:\n- Что я хочу создать:\n- Задействованные языки / платформы:\n- Сроки:\n\nСпасибо!",
    "emailUs": "Напишите нам напрямую",
    "compose": "Составить запрос",
    "noForms": "Никаких веб-форм, никаких трекеров, никакого стороннего бэкенда — ваше сообщение попадает прямо в наш почтовый ящик.",
    "findWork": "Найдите нашу работу",
    "registered": "Юридический адрес",
    "vat": "ИНН"
  },
  ar: {
    "eyebrow": "ألقِ التحية",
    "title": "اتصل بنا",
    "subject": "استفسار عن مشروع — TigreGótico",
    "body": "مرحبًا TigreGótico،\n\nأودّ مناقشة:\n- ما أريد بناءه:\n- اللغات / المنصّات المعنية:\n- الجدول الزمني:\n\nشكرًا!",
    "emailUs": "راسلنا مباشرةً عبر البريد الإلكتروني",
    "compose": "اكتب استفسارًا",
    "noForms": "لا نماذج ويب، ولا أدوات تتبّع، ولا خادم خلفي تابع لطرف ثالث — تصل رسالتك مباشرةً إلى صندوق بريدنا.",
    "findWork": "اعثر على عملنا",
    "registered": "المقر المسجّل",
    "vat": "الرقم الضريبي"
  },
  fa: {
    "eyebrow": "سلام کنید",
    "title": "تماس",
    "subject": "استعلام پروژه — TigreGótico",
    "body": "سلام TigreGótico،\n\nمایلم درباره این موارد گفت‌وگو کنم:\n- آنچه می‌خواهم بسازم:\n- زبان‌ها / پلتفرم‌های درگیر:\n- بازه زمانی:\n\nسپاسگزارم!",
    "emailUs": "مستقیم به ما ایمیل بزنید",
    "compose": "نوشتن یک استعلام",
    "noForms": "بدون فرم وب، بدون ردیاب، بدون بک‌اند شخص ثالث — پیام شما مستقیم به صندوق ورودی ما می‌رسد.",
    "findWork": "کار ما را بیابید",
    "registered": "دفتر ثبت‌شده",
    "vat": "شماره مالیاتی"
  }
}[locale];

const page = await getEntry('pages', pageEntryId(locale, 'contact'));
const { Content } = await render(page!);

const subject = encodeURIComponent(S.subject);
const body = encodeURIComponent(S.body);
const mailtoPrefilled = `mailto:${site.email}?subject=${subject}&body=${body}`;
---

<Base title={page!.data.title} description={page!.data.description} locale={locale}>
  <PageHeader eyebrow={S.eyebrow} title={S.title} lead={page!.data.description} />

  <div class="grid gap-8 lg:grid-cols-2">
    <article class="prose-content">
      <Content />
    </article>

    <div class="card h-max space-y-5">
      <div>
        <p class="text-sm text-muted">{S.emailUs}</p>
        <a class="font-serif text-xl font-semibold text-primary hover:underline" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </div>
      <a class="btn-primary w-full" href={mailtoPrefilled}>
        {S.compose}
      </a>
      <p class="text-xs text-muted">{S.noForms}</p>
      <hr class="border-border" />
      <div>
        <p class="mb-2 text-sm font-semibold">{S.findWork}</p>
        <ul class="space-y-1.5 text-sm">
          <li>
            <a class="text-primary hover:underline" href={site.socials.github} rel="noopener"
              >GitHub — github.com/TigreGotico</a
            >
          </li>
          <li>
            <a class="text-primary hover:underline" href={site.socials.huggingface} rel="noopener"
              >Hugging Face — huggingface.co/TigreGotico</a
            >
          </li>
          <li>
            <a class="text-primary hover:underline" href={site.socials.openvoiceos} rel="noopener"
              >OpenVoiceOS — openvoiceos.org</a
            >
          </li>
        </ul>
      </div>
      <hr class="border-border" />
      <div class="text-xs text-muted">
        <p class="mb-1 font-semibold text-fg">{site.legalName}</p>
        <address class="not-italic leading-relaxed">
          {site.address.lines.map((l) => <span class="block">{l}</span>)}
        </address>
        <p class="mt-1">{S.vat}: {site.nif}</p>
      </div>
    </div>
  </div>
</Base>
