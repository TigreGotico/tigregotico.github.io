---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Blog"
  description="Articles and insights on voice AI, OpenVoiceOS development, synthetic data, and minority-language speech technology."
>
  <header class="mb-10 max-w-2xl">
    <p class="eyebrow mb-2">Writing</p>
    <h1 class="font-serif text-4xl font-bold">Blog</h1>
    <p class="mt-3 text-muted">
      Notes on voice AI, OpenVoiceOS development, synthetic data, and
      minority-language speech technology.
    </p>
  </header>

  <ul class="grid gap-4 sm:grid-cols-2">
    {
      posts.map((post) => (
        <li>
          <a href={`${base}/blog/${post.id}`} class="card-hover flex h-full flex-col gap-2">
            <time
              class="text-xs uppercase tracking-wide text-muted"
              datetime={post.data.date.toISOString()}
            >
              {post.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <h2 class="font-serif text-lg font-semibold">{post.data.title}</h2>
            <p class="flex-1 text-sm text-muted">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="flex flex-wrap gap-1.5">
                {post.data.tags.slice(0, 4).map((tag) => (
                  <li class="badge">{tag}</li>
                ))}
              </ul>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</Base>
