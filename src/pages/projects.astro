---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { loadStars } from '../lib/github';

const projects = (await getCollection('projects')).map((p) => p.data);
const featured = projects.filter((p) => p.featured);

const stars = await loadStars(projects);

// Preferred display order for the category filter.
const categoryOrder = [
  'Platform',
  'In-House',
  'OVOS-Intents',
  'OVOS-Solvers',
  'OVOS-Embeddings',
  'OVOS-STT',
  'OVOS-Translation',
  'OVOS-Utils',
];

const counts = new Map<string, number>();
for (const p of projects) counts.set(p.category, (counts.get(p.category) ?? 0) + 1);
const categories = [...counts.keys()].sort((a, b) => {
  const ia = categoryOrder.indexOf(a);
  const ib = categoryOrder.indexOf(b);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
});

const labels: Record<string, string> = {
  'In-House': 'In-House Tools',
  'OVOS-Intents': 'OVOS — Intents',
  'OVOS-Solvers': 'OVOS — Solvers',
  'OVOS-Embeddings': 'OVOS — Embeddings',
  'OVOS-STT': 'OVOS — Speech-to-Text',
  'OVOS-Translation': 'OVOS — Translation',
  'OVOS-Utils': 'OVOS — Utilities',
};
const label = (c: string) => labels[c] ?? c;

const collaborations = (await getCollection('collaborations')).map((c) => c.data);
---

<Base
  title="Projects"
  description="Open-source platforms, plugins, and tools built and maintained by TigreGótico for the OpenVoiceOS and HiveMind ecosystem."
>
  <PageHeader
    eyebrow="Portfolio"
    title="Projects"
    lead="Open-source platforms, plugins, and tools we build and maintain for the OpenVoiceOS and HiveMind ecosystem."
  />

  <Section eyebrow="Featured" title="Highlights" class="pt-0">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((project) => <ProjectCard project={project} stars={stars[project.id]} withImage />)}
    </div>
  </Section>

  <Section eyebrow="Explore" title="All projects" lead="Filter by area — everything is open source.">
    <div
      id="project-filter"
      class="mb-6 flex flex-wrap gap-2"
      role="group"
      aria-label="Filter projects by category"
    >
      <button
        type="button"
        data-filter="all"
        aria-pressed="true"
        class="chip"
      >
        <span class="chip-label">All</span>
        <span class="chip-sep" aria-hidden="true">·</span>
        <span class="chip-count">{projects.length}</span>
      </button>
      {
        categories.map((c) => (
          <button type="button" data-filter={c} aria-pressed="false" class="chip">
            <span class="chip-label">{label(c)}</span>
            <span class="chip-sep" aria-hidden="true">·</span>
            <span class="chip-count">{counts.get(c)}</span>
          </button>
        ))
      }
    </div>

    <div id="project-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project) => (
          <div class="project-item" data-category={project.category}>
            <ProjectCard project={project} stars={stars[project.id]} />
          </div>
        ))
      }
    </div>
  </Section>

  {
    collaborations.length > 0 && (
      <Section
        eyebrow="Collaborations"
        title="Working with the community"
        lead="Independent partners and projects we contribute to."
      >
        <div class="grid gap-4 sm:grid-cols-2">
          {collaborations.map((collab) => (
            <article class="card-hover reveal" data-reveal>
              <h3 class="display-3 text-lg">
                <a href={collab.url} class="transition-colors hover:text-primary" rel="noopener">
                  {collab.name}
                </a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{collab.description}</p>
            </article>
          ))}
        </div>
      </Section>
    )
  }
</Base>

<style>
  .chip {
    @apply inline-flex items-center gap-1.5 rounded-full border border-border bg-surface/60 px-3.5 py-1.5 text-sm text-muted transition-colors;
  }
  .chip:hover {
    @apply border-primary/60 text-fg;
  }
  .chip[aria-pressed='true'] {
    @apply border-primary font-semibold text-primary;
    background: var(--gradient-brand-soft);
  }
  .chip-sep {
    @apply text-border;
  }
  .chip-count {
    @apply inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-fg/10 px-1.5 py-0.5 text-xs font-semibold text-fg;
  }
  .chip[aria-pressed='true'] .chip-sep {
    @apply text-primary/40;
  }
  .chip[aria-pressed='true'] .chip-count {
    @apply bg-primary/15 text-primary;
  }
</style>

<script is:inline>
  (function () {
    var bar = document.getElementById('project-filter');
    var grid = document.getElementById('project-grid');
    if (!bar || !grid) return;
    var chips = bar.querySelectorAll('[data-filter]');
    var items = grid.querySelectorAll('.project-item');
    function set(val) {
      for (var i = 0; i < chips.length; i++) {
        chips[i].setAttribute(
          'aria-pressed',
          String(chips[i].getAttribute('data-filter') === val)
        );
      }
      for (var j = 0; j < items.length; j++) {
        var cat = items[j].getAttribute('data-category');
        items[j].hidden = !(val === 'all' || cat === val);
      }
    }
    for (var i = 0; i < chips.length; i++) {
      chips[i].addEventListener('click', function () {
        set(this.getAttribute('data-filter'));
      });
    }
  })();
</script>
