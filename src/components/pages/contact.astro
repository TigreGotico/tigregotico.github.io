---
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import { getEntry, render } from 'astro:content';
import { site } from '../../data/site';
import { pageEntryId, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}
const locale: Locale = Astro.props.locale ?? 'en';
const S = {
  en: {
    eyebrow: 'Say hello',
    title: 'Contact',
    subject: 'Project inquiry — TigreGótico',
    body: 'Hi TigreGótico,\n\nI would like to discuss:\n- What I want to build:\n- Languages / platforms involved:\n- Timeline:\n\nThanks!',
    emailUs: 'Email us directly',
    compose: 'Compose an inquiry',
    noForms:
      'No web forms, no trackers, no third-party backend — your message goes straight to our inbox.',
    findWork: 'Find our work',
  },
  pt: {
    eyebrow: 'Diga olá',
    title: 'Contacto',
    subject: 'Pedido de projeto — TigreGótico',
    body: 'Olá TigreGótico,\n\nGostaria de discutir:\n- O que quero construir:\n- Línguas / plataformas envolvidas:\n- Prazo:\n\nObrigado!',
    emailUs: 'Escreva-nos diretamente',
    compose: 'Compor uma mensagem',
    noForms:
      'Sem formulários web, sem rastreadores, sem backend de terceiros — a sua mensagem vai diretamente para a nossa caixa de correio.',
    findWork: 'Encontre o nosso trabalho',
  },
}[locale];

const page = await getEntry('pages', pageEntryId(locale, 'contact'));
const { Content } = await render(page!);

const subject = encodeURIComponent(S.subject);
const body = encodeURIComponent(S.body);
const mailtoPrefilled = `mailto:${site.email}?subject=${subject}&body=${body}`;
---

<Base title={page!.data.title} description={page!.data.description} locale={locale}>
  <PageHeader eyebrow={S.eyebrow} title={S.title} lead={page!.data.description} />

  <div class="grid gap-8 lg:grid-cols-2">
    <article class="prose-content">
      <Content />
    </article>

    <div class="card h-max space-y-5">
      <div>
        <p class="text-sm text-muted">{S.emailUs}</p>
        <a class="font-serif text-xl font-semibold text-primary hover:underline" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </div>
      <a class="btn-primary w-full" href={mailtoPrefilled}>
        {S.compose}
      </a>
      <p class="text-xs text-muted">{S.noForms}</p>
      <hr class="border-border" />
      <div>
        <p class="mb-2 text-sm font-semibold">{S.findWork}</p>
        <ul class="space-y-1.5 text-sm">
          <li>
            <a class="text-primary hover:underline" href={site.socials.github} rel="noopener"
              >GitHub — github.com/TigreGotico</a
            >
          </li>
          <li>
            <a class="text-primary hover:underline" href={site.socials.huggingface} rel="noopener"
              >Hugging Face — huggingface.co/TigreGotico</a
            >
          </li>
          <li>
            <a class="text-primary hover:underline" href={site.socials.openvoiceos} rel="noopener"
              >OpenVoiceOS — openvoiceos.org</a
            >
          </li>
        </ul>
      </div>
    </div>
  </div>
</Base>
