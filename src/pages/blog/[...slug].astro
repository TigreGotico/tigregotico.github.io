---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

export const getStaticPaths = (async () => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // Chronological neighbours (newer = prev, older = next).
      prev: posts[i - 1] ?? null,
      next: posts[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { post, prev, next } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);

// Reading time from rendered word count (~200 wpm).
const words: number = remarkPluginFrontmatter?.words ?? 0;
const readingMinutes = words ? Math.max(1, Math.round(words / 200)) : 0;

const ogImage = post.data.cover
  ? post.data.cover.src
  : post.data.coverExternal;

const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  ...(post.data.updated
    ? { dateModified: post.data.updated.toISOString() }
    : {}),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@type': 'Organization', name: site.name },
  keywords: post.data.tags.join(', '),
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={ogImage}
  type="article"
  jsonLd={blogPostingLd}
  publishedTime={post.data.date.toISOString()}
  modifiedTime={post.data.updated?.toISOString()}
>
  <article class="space-y-6">
    <p>
      <a class="text-sm text-primary hover:underline" href={`${base}/blog`}
        >&larr; All posts</a
      >
    </p>
    <header class="space-y-2">
      <p class="text-sm text-muted">
        <time datetime={post.data.date.toISOString()}>
          {
            post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </time>
        {post.data.author && <span> · {post.data.author}</span>}
        {readingMinutes > 0 && <span> · {readingMinutes} min read</span>}
      </p>
      <h1 class="text-3xl font-bold">{post.data.title}</h1>
      {
        post.data.tags.length > 0 && (
          <ul class="flex flex-wrap gap-2 text-xs text-muted">
            {post.data.tags.map((tag) => (
              <li class="rounded-full border border-border px-2 py-0.5">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      post.data.cover && (
        <Image
          src={post.data.cover}
          alt={post.data.title}
          class="rounded-lg"
          widths={[480, 800, 1200]}
          sizes="(max-width: 800px) 100vw, 800px"
        />
      )
    }

    <div class="post-body">
      <Content />
    </div>

    {
      (prev || next) && (
        <nav
          class="mt-12 grid gap-4 border-t border-border pt-6 sm:grid-cols-2"
          aria-label="More posts"
        >
          {prev ? (
            <a href={`${base}/blog/${prev.id}`} class="card-hover">
              <p class="text-xs uppercase tracking-wide text-muted">Newer</p>
              <p class="mt-1 font-serif font-semibold">{prev.data.title}</p>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a href={`${base}/blog/${next.id}`} class="card-hover sm:text-right">
              <p class="text-xs uppercase tracking-wide text-muted">Older</p>
              <p class="mt-1 font-serif font-semibold">{next.data.title}</p>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>
