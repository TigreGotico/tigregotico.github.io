---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const ogImage = post.data.cover
  ? post.data.cover.src
  : post.data.coverExternal;

const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  ...(post.data.updated
    ? { dateModified: post.data.updated.toISOString() }
    : {}),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@type': 'Organization', name: site.name },
  keywords: post.data.tags.join(', '),
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={ogImage}
  type="article"
  jsonLd={blogPostingLd}
  publishedTime={post.data.date.toISOString()}
  modifiedTime={post.data.updated?.toISOString()}
>
  <article class="space-y-6">
    <header class="space-y-2">
      <p class="text-sm text-muted">
        <time datetime={post.data.date.toISOString()}>
          {
            post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </time>
        {post.data.author && <span> · {post.data.author}</span>}
      </p>
      <h1 class="text-3xl font-bold">{post.data.title}</h1>
      {
        post.data.tags.length > 0 && (
          <ul class="flex flex-wrap gap-2 text-xs text-muted">
            {post.data.tags.map((tag) => (
              <li class="rounded-full border border-border px-2 py-0.5">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      post.data.cover && (
        <Image
          src={post.data.cover}
          alt={post.data.title}
          class="rounded-lg"
          widths={[480, 800, 1200]}
          sizes="(max-width: 800px) 100vw, 800px"
        />
      )
    }

    <div class="post-body space-y-4">
      <Content />
    </div>
  </article>
</Base>
