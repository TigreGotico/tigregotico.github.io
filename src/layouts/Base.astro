---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import PaletteSelector from '../components/PaletteSelector.astro';
import Reveal from '../components/Reveal.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { ui, dir, navItems, localePath, translatedPaths, locales, languageNames, langNote, type Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  locale?: Locale;
}

const props = Astro.props;
const locale: Locale = props.locale ?? 'en';
const t = ui[locale];
const base = import.meta.env.BASE_URL;
// Emit trailing-slash URLs to match canonicals/sitemap and avoid Pages 301s.
const navLink = (href: string) =>
  (base.replace(/\/$/, '') + (() => {
    const p = localePath(locale, href);
    return p === '/' ? '/' : p + '/';
  })()).replace(/\/\/+$/, '/');

// Mark the current section active (matches /section and /section/...).
const here = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const target = navLink(href).replace(/\/$/, '');
  if (href === '/') return here === target;
  return here === target || here.startsWith(target + '/');
};

// Language switcher: for each locale, resolve the counterpart of the current
// page. Strip the current locale prefix to a canonical path, then map it into
// each target locale (falling back to a section root or home when the exact
// page has no translation).
const baseNoSlash = base.replace(/\/$/, '');
const sitePath = (here.startsWith(baseNoSlash) ? here.slice(baseNoSlash.length) : here) || '/';
const localePrefix = /^\/(pt|es|de|nl|fr|it|ru|ar|fa)(?=\/|$)/;
const enPath = sitePath.replace(localePrefix, '') || '/';
// Blog posts exist only in en + pt; other locales point at their /blog index.
const isBlogPost = /^\/blog\/.+/.test(enPath);
const withSlash = (p: string) => (p === '/' ? '/' : p + '/');
const targetPath = (target: Locale) => {
  let path: string;
  if (isBlogPost) {
    path = target === 'en' || target === 'pt' ? enPath : '/blog';
  } else if (translatedPaths.includes(enPath)) {
    path = enPath;
  } else {
    const root = '/' + (enPath.split('/')[1] ?? '');
    path = translatedPaths.includes(root) ? root : '/';
  }
  return (baseNoSlash + withSlash(localePath(target, path))).replace(/\/\/+$/, '/');
};
const langLinks = locales.map((l) => ({ locale: l, name: languageNames[l], href: targetPath(l), current: l === locale }));

// Pages that exist only in English (e.g. the demo) keep unprefixed URLs.
const enLink = (href: string) =>
  (base.replace(/\/$/, '') + (href === '/' ? '/' : href + '/')).replace(/\/\/+$/, '/');

const year = new Date().getFullYear();
const projectLinks = [
  { label: 'OpenVoiceOS', href: 'https://github.com/OpenVoiceOS' },
  { label: 'HiveMind', href: 'https://github.com/JarbasHiveMind' },
  { label: 'phoonnx', href: 'https://github.com/TigreGotico/phoonnx' },
];
---

<!doctype html>
<html lang={t.lang} dir={dir[locale]} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml" />
    <link rel="sitemap" href={base + 'sitemap-index.xml'} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href={base + 'rss.xml'}
    />
    <Seo {...props} />

    <!-- Brand fonts are self-hosted (src/styles/fonts.css) — no third-party requests. -->

    <!-- Apply persisted/preferred theme before paint to avoid a flash. -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia(
            '(prefers-color-scheme: dark)'
          ).matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
          var palette = localStorage.getItem('palette');
          document.documentElement.dataset.theme =
            palette === 'hivemind' || palette === 'noir' || palette === 'slop'
              ? palette
              : 'tiger';
        } catch (e) {
          document.documentElement.dataset.theme = 'tiger';
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <div class="grain-overlay" aria-hidden="true"></div>
    <a href="#main" class="skip-link">{t.a11y.skip}</a>

    <header
      id="site-header"
      class="sticky top-0 z-40 border-b border-transparent transition-all duration-300"
    >
      <nav
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4"
        aria-label={t.a11y.primaryNav}
      >
        <a
          href={navLink('/')}
          class="group inline-flex items-center gap-2 font-display text-xl font-semibold tracking-wide"
        >
          <span
            class="inline-flex h-7 w-7 items-center justify-center rounded-lg text-primary-fg"
            style="background: var(--gradient-brand);"
            aria-hidden="true"
          >
            <Icon name="waveform" class="h-4 w-4" />
          </span>
          <span class="text-gradient">TigreGótico</span>
        </a>
        <ul class="hidden gap-6 text-sm lg:flex">
          {
            navItems(locale).map((item) => (
              <li>
                <a
                  href={navLink(item.href)}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'nav-link',
                    isActive(item.href)
                      ? 'font-semibold text-fg'
                      : 'text-muted hover:text-fg',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="flex items-center gap-2">
          <details class="lang-switch relative">
            <summary
              class="flex h-9 cursor-pointer list-none items-center gap-1 rounded-lg border border-border px-2.5 font-display text-xs font-semibold uppercase tracking-wider text-fg transition-colors hover:border-primary hover:text-primary"
              title={t.chooseLanguage}
            >
              <Icon name="globe" class="h-4 w-4" />
              <span class="sr-only">{t.chooseLanguage}: </span>
              {locale.toUpperCase()}
            </summary>
            <ul
              class="lang-menu absolute z-50 mt-2 min-w-[9rem] overflow-hidden rounded-lg border border-border bg-elevated py-1 text-sm shadow-lg"
              style="box-shadow: var(--shadow-elevate);"
            >
              {
                langLinks.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      hreflang={ui[l.locale].lang}
                      aria-current={l.current ? 'true' : undefined}
                      class:list={[
                        'block px-3 py-1.5 transition-colors hover:bg-surface',
                        l.current ? 'font-semibold text-primary' : 'text-muted hover:text-fg',
                      ]}
                    >
                      {l.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
          <PaletteSelector id="palette-desktop" />
          <ThemeToggle />
          <button
            id="nav-toggle"
            type="button"
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border text-fg transition-colors hover:border-primary hover:text-primary lg:hidden"
            aria-label={t.a11y.openMenu}
            aria-expanded="false"
            aria-controls="mobile-nav"
            data-label-open={t.a11y.openMenu}
            data-label-close={t.a11y.closeMenu}
          >
            <svg
              class="nav-icon-open h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <svg
              class="nav-icon-close hidden h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
        </div>
      </nav>
      <nav aria-label={t.a11y.mobileNav}>
      <ul
        id="mobile-nav"
        class="hidden border-t border-border bg-bg/95 px-6 py-3 text-sm backdrop-blur lg:hidden"
      >
        {
          navItems(locale).map((item) => (
            <li>
              <a
                href={navLink(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block rounded-lg px-3 py-2.5 transition-colors hover:bg-surface',
                  isActive(item.href)
                    ? 'font-semibold text-primary'
                    : 'text-muted hover:text-fg',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="mt-1 flex items-center justify-between gap-3 border-t border-border px-3 pb-1 pt-3">
          <span class="font-display text-xs uppercase tracking-[0.2em] text-muted">
            {t.footer.appearance}
          </span>
          <PaletteSelector id="palette-mobile" compact />
        </li>
      </ul>
      </nav>
    </header>

    <main id="main" tabindex="-1" class="mx-auto w-full max-w-5xl flex-1 px-6 py-12 focus:outline-none">
      <slot />
    </main>

    <footer class="relative mt-8 border-t border-border">
      <div
        class="pointer-events-none absolute inset-0 -z-10 opacity-60"
        style="background: radial-gradient(60% 100% at 50% 0%, rgb(var(--grad-via) / 0.08), transparent 70%);"
        aria-hidden="true"
      >
      </div>
      <div class="mx-auto grid max-w-5xl gap-10 px-6 py-14 sm:grid-cols-2 lg:grid-cols-4">
        <div class="space-y-3 sm:col-span-2 lg:col-span-1">
          <p class="inline-flex items-center gap-2 font-display text-lg font-semibold tracking-wide">
            <span
              class="inline-flex h-6 w-6 items-center justify-center rounded-md text-primary-fg"
              style="background: var(--gradient-brand);"
              aria-hidden="true"
            >
              <Icon name="waveform" class="h-3.5 w-3.5" />
            </span>
            <span class="text-gradient">TigreGótico</span>
          </p>
          <p class="text-sm text-muted">{t.footer.tagline}</p>
        </div>

        <nav aria-label={t.footer.explore}>
          <p class="mb-3 font-display text-xs uppercase tracking-[0.2em] text-fg">{t.footer.explore}</p>
          <ul class="space-y-2 text-sm text-muted">
            {
              navItems(locale).map((item) => (
                <li>
                  <a class="transition-colors hover:text-fg" href={navLink(item.href)}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="transition-colors hover:text-fg" href={enLink('/demo')}>
                {t.footer.voicesDemo}
              </a>
            </li>
          </ul>
        </nav>

        <nav aria-label={t.footer.projects}>
          <p class="mb-3 font-display text-xs uppercase tracking-[0.2em] text-fg">{t.footer.projects}</p>
          <ul class="space-y-2 text-sm text-muted">
            {
              projectLinks.map((p) => (
                <li>
                  <a class="transition-colors hover:text-fg" href={p.href} rel="noopener">
                    {p.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div>
          <p class="mb-3 font-display text-xs uppercase tracking-[0.2em] text-fg">{t.footer.connect}</p>
          <ul class="space-y-2 text-sm text-muted">
            <li><a class="inline-flex items-center gap-1.5 transition-colors hover:text-fg" href={site.socials.github} rel="noopener"><Icon name="github" class="h-4 w-4" />GitHub</a></li>
            <li><a class="transition-colors hover:text-fg" href={site.socials.huggingface} rel="noopener">Hugging Face</a></li>
            <li><a class="transition-colors hover:text-fg" href={site.socials.linkedin} rel="noopener">LinkedIn</a></li>
            <li><a class="transition-colors hover:text-fg" href={site.socials.openvoiceos} rel="noopener">OpenVoiceOS.org</a></li>
            <li><a class="inline-flex items-center gap-1.5 transition-colors hover:text-fg" href={`mailto:${site.email}`}><Icon name="mail" class="h-4 w-4" />{site.email}</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-border">
        <div class="mx-auto max-w-5xl px-6 py-5 text-xs text-muted">
          <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <span>© {year} {site.legalName}. {t.footer.foss}</span>
            <a class="transition-colors hover:text-fg" href={navLink('/privacy')}>{t.footer.privacy}</a>
          </p>
          <address class="mt-2 not-italic">
            {site.address.lines.join(', ')} · {t.footer.vat} {site.nif}
          </address>
          <p class="mt-2 max-w-3xl opacity-80">{langNote[locale]}</p>
        </div>
      </div>
    </footer>

    <Reveal />

    <script is:inline>
      (function () {
        var btn = document.getElementById('nav-toggle');
        var menu = document.getElementById('mobile-nav');
        if (btn && menu) {
          var setOpen = function (open) {
            menu.classList.toggle('hidden', !open);
            btn.setAttribute('aria-expanded', String(open));
            btn.setAttribute(
              'aria-label',
              open ? btn.dataset.labelClose : btn.dataset.labelOpen
            );
            btn.querySelector('.nav-icon-open').classList.toggle('hidden', open);
            btn.querySelector('.nav-icon-close').classList.toggle('hidden', !open);
          };
          var isOpen = function () {
            return !menu.classList.contains('hidden');
          };
          btn.addEventListener('click', function () {
            setOpen(!isOpen());
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && isOpen()) {
              setOpen(false);
              btn.focus();
            }
          });
          document.addEventListener('click', function (e) {
            if (isOpen() && !menu.contains(e.target) && !btn.contains(e.target)) {
              setOpen(false);
            }
          });
        }
        // Close the language dropdown on outside click / Escape.
        document.querySelectorAll('details.lang-switch').forEach(function (d) {
          document.addEventListener('click', function (e) {
            if (d.open && !d.contains(e.target)) d.open = false;
          });
          d.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') d.open = false;
          });
        });
        // Translucent backdrop-blur once the page has scrolled.
        var header = document.getElementById('site-header');
        if (header) {
          var onScroll = function () {
            if (window.scrollY > 8) {
              header.classList.add('is-scrolled');
            } else {
              header.classList.remove('is-scrolled');
            }
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }
      })();
    </script>

    <style is:global>
      details.lang-switch > summary::-webkit-details-marker { display: none; }
      details.lang-switch > summary::marker { content: ''; }
    </style>
  </body>
</html>
