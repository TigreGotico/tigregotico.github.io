---
// Theme toggle. The no-flash inline script in Base.astro sets the initial
// `dark` class before paint; this button flips it and persists the choice.
//
// Base.astro doesn't pass a `locale` prop down to this component, so the
// locale is derived from the URL the same way Base.astro's own language
// switcher does (matching a leading locale-segment prefix).
import { ui, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const localePrefix = /^\/(pt|es|de|nl|fr|it|ru|ar|fa|hi|zh|ko|ja)(?=\/|$)/;
const detected = Astro.url.pathname.match(localePrefix)?.[1] as Locale | undefined;
const { locale = detected ?? 'en' } = Astro.props;
const t = ui[locale].a11y;
---

<button
  id="theme-toggle"
  type="button"
  class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border text-fg transition-colors hover:border-primary hover:text-primary"
  aria-label={t.themeToggle}
  aria-pressed="false"
>
  <svg
    class="h-5 w-5 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg
    class="hidden h-5 w-5 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    function sync() {
      var isDark = document.documentElement.classList.contains('dark');
      btn.setAttribute('aria-pressed', String(isDark));
    }
    sync();
    btn.addEventListener('click', function () {
      var isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (e) {}
      sync();
    });
  })();
</script>
