---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).map((p) => p.data);
const featured = projects.filter((p) => p.featured);

// Group every project by category, preferring a sensible display order.
const categoryOrder = [
  'Platform',
  'In-House',
  'OVOS-Intents',
  'OVOS-Solvers',
  'OVOS-Embeddings',
  'OVOS-STT',
  'OVOS-Translation',
  'OVOS-Utils',
  'ILENIA',
];

const byCategory = new Map<string, typeof projects>();
for (const p of projects) {
  if (!byCategory.has(p.category)) byCategory.set(p.category, []);
  byCategory.get(p.category)!.push(p);
}
const categories = [...byCategory.keys()].sort((a, b) => {
  const ia = categoryOrder.indexOf(a);
  const ib = categoryOrder.indexOf(b);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
});

const collaborations = (await getCollection('collaborations')).map((c) => c.data);

const labels: Record<string, string> = {
  'In-House': 'In-House Tools',
  'OVOS-Intents': 'OVOS — Intents',
  'OVOS-Solvers': 'OVOS — Solvers',
  'OVOS-Embeddings': 'OVOS — Embeddings',
  'OVOS-STT': 'OVOS — Speech-to-Text',
  'OVOS-Translation': 'OVOS — Translation',
  'OVOS-Utils': 'OVOS — Utilities',
  ILENIA: 'ILENIA — Multilingual Speech',
};
const label = (c: string) => labels[c] ?? c;
---

<Base
  title="Projects"
  description="Open-source platforms, plugins, and tools built and maintained by TigreGótico across the OpenVoiceOS and HiveMind ecosystem."
>
  <PageHeader
    eyebrow="Portfolio"
    title="Projects"
    lead="Open-source platforms, plugins, and tools we build and maintain across the OpenVoiceOS and HiveMind ecosystem."
  />

  <Section eyebrow="Featured" title="Highlights" class="pt-0">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((project) => <ProjectCard project={project} withImage />)}
    </div>
  </Section>

  {
    categories.map((category) => (
      <Section title={label(category)}>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {byCategory
            .get(category)!
            .map((project) => (
              <ProjectCard project={project} />
            ))}
        </div>
      </Section>
    ))
  }

  {
    collaborations.length > 0 && (
      <Section
        eyebrow="Collaborations"
        title="Working with the community"
        lead="Partnerships that bring privacy-first voice to more languages and platforms."
      >
        <div class="grid gap-4 sm:grid-cols-2">
          {collaborations.map((collab) => (
            <article class="card-hover reveal" data-reveal>
              <h3 class="display-3 text-lg">
                <a href={collab.url} class="transition-colors hover:text-primary" rel="noopener">
                  {collab.name}
                </a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{collab.description}</p>
              <p class="mt-3">
                <span class="badge-accent">{collab.repositories.length} related repositories</span>
              </p>
            </article>
          ))}
        </div>
      </Section>
    )
  }
</Base>
