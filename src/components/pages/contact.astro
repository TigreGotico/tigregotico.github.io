    "findWork": "우리의 작업 찾기",
    "registered": "등록 사무소",
    "vat": "사업자등록번호"
  },
  ja: {
    "eyebrow": "ご挨拶を",
    "title": "お問い合わせ",
    "subject": "プロジェクトのお問い合わせ — TigreGótico",
    "body": "TigreGótico さま\n\n以下についてご相談したいと思います：\n- 作りたいもの：\n- 関係する言語／プラットフォーム：\n- スケジュール：\n\nよろしくお願いします！",
    "emailUs": "直接メールでご連絡ください",
    "compose": "お問い合わせを作成",
    "noForms": "ウェブフォームも、トラッカーも、サードパーティのバックエンドもありません — あなたのメッセージは私たちの受信箱に直接届きます。",
    "findWork": "私たちの仕事を見つける",
    "registered": "登記上の所在地",
    "vat": "納税者番号"
  }
