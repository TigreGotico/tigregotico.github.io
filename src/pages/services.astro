---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getEntry, render } from 'astro:content';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const page = await getEntry('pages', 'services');
const { Content } = await render(page!);
---

<Base title={page!.data.title} description={page!.data.description}>
  <PageHeader eyebrow="Engagements" title="Services" lead={page!.data.description} />

  <article class="prose-content max-w-3xl">
    <Content />
  </article>

  <div class="mt-12 flex flex-wrap items-center gap-3 rounded-2xl border border-border bg-surface p-6" style="box-shadow: var(--shadow-elevate);">
    <p class="w-full display-3 text-lg">Ready to scope an engagement?</p>
    <a class="btn-primary" href={`${base}/contact`}>Contact us</a>
    <a class="btn-ghost" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</Base>
