---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Page Not Found" description="The page you are looking for does not exist.">
  <div class="py-16 text-center">
    <h1 class="text-4xl font-bold">404</h1>
    <p class="mt-4 text-muted">The page you are looking for does not exist.</p>
    <a
      href={`${base}/`}
      class="mt-6 inline-block rounded-md bg-primary px-4 py-2 text-primary-fg"
      >Back home</a
    >
  </div>
</Base>
