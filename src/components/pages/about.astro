---
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import { getEntry, render } from 'astro:content';
import { site } from '../../data/site';
import { pageEntryId, type Locale } from '../../i18n';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? 'en';
const S = {
  en: {
    eyebrow: 'Who we are',
    title: 'About TigreGótico',
    verify: 'Verify our work',
    github: 'GitHub organization',
    hf: 'Hugging Face',
  },
  pt: {
    eyebrow: 'Quem somos',
    title: 'Sobre a TigreGótico',
    verify: 'Verifique o nosso trabalho',
    github: 'Organização no GitHub',
    hf: 'Hugging Face',
  },
  es: {
    "eyebrow": "Quiénes somos",
    "title": "Acerca de TigreGótico",
    "verify": "Verifique nuestro trabajo",
    "github": "Organización en GitHub",
    "hf": "Hugging Face"
  },
  de: {
    "eyebrow": "Wer wir sind",
    "title": "Über TigreGótico",
    "verify": "Überprüfen Sie unsere Arbeit",
    "github": "GitHub-Organisation",
    "hf": "Hugging Face"
  },
  nl: {
    "eyebrow": "Wie we zijn",
    "title": "Over TigreGótico",
    "verify": "Verifieer ons werk",
    "github": "GitHub-organisatie",
    "hf": "Hugging Face"
  },
  fr: {
    "eyebrow": "Qui nous sommes",
    "title": "À propos de TigreGótico",
    "verify": "Vérifiez notre travail",
    "github": "Organisation GitHub",
    "hf": "Hugging Face"
  },
  it: {
    "eyebrow": "Chi siamo",
    "title": "Chi è TigreGótico",
    "verify": "Verifica il nostro lavoro",
    "github": "Organizzazione su GitHub",
    "hf": "Hugging Face"
  },
  ru: {
    "eyebrow": "Кто мы",
    "title": "О TigreGótico",
    "verify": "Проверьте нашу работу",
    "github": "Организация на GitHub",
    "hf": "Hugging Face"
  },
  ar: {
    "eyebrow": "من نحن",
    "title": "عن TigreGótico",
    "verify": "تحقّق من عملنا",
    "github": "منظمة GitHub",
    "hf": "Hugging Face"
  },
  fa: {
    "eyebrow": "ما که هستیم",
    "title": "درباره TigreGótico",
    "verify": "کار ما را راستی‌آزمایی کنید",
    "github": "سازمان در GitHub",
    "hf": "Hugging Face"
  },
  hi: {
    "eyebrow": "हम कौन हैं",
    "title": "TigreGótico के बारे में",
    "verify": "हमारे काम को सत्यापित करें",
    "github": "GitHub संगठन",
    "hf": "Hugging Face"
  },
  zh: {
    "eyebrow": "我们是谁",
    "title": "关于 TigreGótico",
    "verify": "查验我们的成果",
    "github": "GitHub 组织",
    "hf": "Hugging Face"
  },
  ko: {
    "eyebrow": "우리는 누구인가",
    "title": "TigreGótico 소개",
    "verify": "우리의 작업을 확인하세요",
    "github": "GitHub 조직",
    "hf": "Hugging Face"
  },
  ja: {
    "eyebrow": "私たちについて",
    "title": "TigreGótico について",
    "verify": "私たちの仕事を確かめる",
    "github": "GitHub 組織",
    "hf": "Hugging Face"
  }
}[locale];

const page = await getEntry('pages', pageEntryId(locale, 'about'));
const { Content } = await render(page!);
---

<Base title={page!.data.title} description={page!.data.description} locale={locale}>
  <PageHeader eyebrow={S.eyebrow} title={S.title} lead={page!.data.description} />

  <div class="grid gap-8 lg:grid-cols-[1fr_16rem]">
    <article class="prose-content max-w-3xl">
      <Content />
    </article>

    <aside class="card h-max text-sm">
      <p class="display-3 text-base">{S.verify}</p>
      <ul class="mt-3 space-y-2">
        <li>
          <a class="text-primary hover:underline" href={site.socials.github} rel="noopener"
            >{S.github}</a
          >
        </li>
        <li>
          <a class="text-primary hover:underline" href={site.socials.huggingface} rel="noopener"
            >Hugging Face</a
          >
        </li>
        <li>
          <a class="text-primary hover:underline" href={site.socials.openvoiceos} rel="noopener"
            >openvoiceos.org</a
          >
        </li>
      </ul>
    </aside>
  </div>
</Base>
