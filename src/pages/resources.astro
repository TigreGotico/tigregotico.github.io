---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { getEntry, getCollection, render } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const page = await getEntry('pages', 'resources');
const { Content } = await render(page!);

const datasets = (await getCollection('datasets')).map((d) => d.data);
const models = (await getCollection('models')).map((m) => m.data);
const notebooks = (await getCollection('notebooks')).map((n) => n.data);
const research = (await getCollection('research')).map((r) => r.data);

// Notebook/research file paths are public assets → prefix base, tolerating
// values with or without a leading slash.
const asset = (url: string) =>
  url.startsWith('http') ? url : `${base}/${url.replace(/^\//, '')}`;
---

<Base title={page!.data.title} description={page!.data.description}>
  <header class="mb-10 max-w-2xl">
    <p class="eyebrow mb-2">Open & free</p>
    <h1 class="font-serif text-4xl font-bold">Resources</h1>
    <p class="mt-3 text-muted">{page!.data.description}</p>
  </header>

  <article class="prose-content mb-4 max-w-3xl">
    <Content />
  </article>

  <Section title="Datasets" lead="Open speech and language datasets on Hugging Face.">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        datasets.map((d) => (
          <ResourceCard
            title={d.title}
            description={d.description}
            url={d.url}
            cta="View on Hugging Face"
          />
        ))
      }
    </div>
  </Section>

  <Section title="Models" lead="Optimized, Piper-compatible models for offline inference.">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        models.map((m) => (
          <ResourceCard
            title={m.title}
            description={m.description}
            url={m.url}
            cta="View on Hugging Face"
          />
        ))
      }
    </div>
  </Section>

  <Section title="Notebooks" lead="Reproducible pipelines and experiments.">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        notebooks.map((n) => (
          <ResourceCard
            title={n.title}
            description={n.description}
            url={asset(n.url)}
            cta="Open notebook"
            meta={`${n.year} · ${n.language}`}
            tags={n.tags}
          />
        ))
      }
    </div>
  </Section>

  <Section title="Research" lead="Whitepapers and technical write-ups.">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        research.map((r) => (
          <ResourceCard
            title={r.title}
            description={r.description}
            url={asset(r.filePath)}
            cta={r.buttonLabel}
            meta={`${r.year} · ${r.fileType.toUpperCase()}`}
            tags={r.tags}
          />
        ))
      }
    </div>
  </Section>
</Base>
