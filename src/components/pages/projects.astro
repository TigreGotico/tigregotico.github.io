const projects = (await getCollection('projects')).map((p) => p.data).filter((p) => !p.hidden);
const featured = projects.filter((p) => p.featured);

// Single-axis taxonomy (by capability). Display order for the filter row.
const categoryOrder = [
  'Speech Synthesis',
  'Speech Recognition',
  'Wake Words',
  'Phonetics & G2P',
  'NLP & Language',
  'Media & Music',
  'Data & Scraping',
  'Smart Home',
  'Games',
  'Developer Tools',
  'OpenVoiceOS',
  'HiveMind',
  'ILENIA',
  'Visio',
];

const counts = new Map<string, number>();
for (const p of projects) {
  const cats = Array.isArray(p.category) ? p.category : [p.category];
  for (const cat of cats) {
    counts.set(cat, (counts.get(cat) ?? 0) + 1);
  }
}
const categories = [...counts.keys()].sort((a, b) => {
  const ia = categoryOrder.indexOf(a);
  const ib = categoryOrder.indexOf(b);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
});

const label = (c: string) => S.catLabels[c] ?? c;

// Cross-cutting tag filters — axes that span categories (funding, language, platform).
const tagMeta: Record<string, string> = {
  ILENIA: S.tagILENIA,
  NLnet: S.tagNLnet,
  Visio: S.tagVisio,
  Portuguese: S.tagPortuguese,
  JavaScript: S.tagJavaScript,
};
const tagFilters = ['Portuguese', 'JavaScript', 'NLnet']
  .map((t) => ({ tag: t, count: projects.filter((p) => p.tags.includes(t)).length, title: tagMeta[t] }))
  .filter((t) => t.count > 0);

const collaborations = (await getCollection('collaborations')).map((c) => c.data);
---

<Base title={S.title} description={S.description} locale={locale}>
  <PageHeader eyebrow={S.eyebrow} title={S.title} lead={S.lead} />

  <p class="-mt-4 max-w-3xl text-muted">
    {S.beyond1}
    <a class="font-medium text-primary hover:underline" href="https://huggingface.co/TigreGotico" rel="noopener">Hugging Face</a>,
    {S.beyond2}
    <a class="font-medium text-primary hover:underline" href="https://github.com/TigreGotico/ml-notebooks" rel="noopener">ml-notebooks</a>{S.beyond3}
  </p>

  <Section
    eyebrow={S.community}
    title={S.communityTitle}
    lead={S.communityLead}
    class="pt-0"
  >
    {collaborations.length > 0 && (
      <div class="grid gap-4 sm:grid-cols-2">
        {collaborations.map((collab) => (
          <article class="card-hover reveal" data-reveal>
            <h3 class="display-3 text-lg">
              <a href={collab.url} class="transition-colors hover:text-primary" rel="noopener">
                {collab.name}
              </a>
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{collab.description}</p>
          </article>
        ))}
      </div>
    )}
  </Section>

  <Section eyebrow={S.explore} title={S.exploreTitle} lead={S.exploreLead}>
    <div
      id="project-filter"
      class="mb-6 flex flex-wrap gap-2"
      role="group"
      aria-label={S.filterLabel}
    >
      {
        categories.map((c) => (
          <button type="button" data-filter={c} aria-pressed="false" class="chip">
            <span class="chip-label">{label(c)}</span>
            <span class="chip-sep" aria-hidden="true">·</span>
            <span class="chip-count">{counts.get(c)}</span>
          </button>
        ))
      }
      {
        tagFilters.map((t) => (
          <button
            type="button"
            data-filter={`tag:${t.tag}`}
            aria-pressed="false"
            class="chip chip-tag"
            title={t.title}
          >
            <span class="chip-label">{t.tag}</span>
            <span class="chip-sep" aria-hidden="true">·</span>
            <span class="chip-count">{t.count}</span>
          </button>
        ))
      }
    </div>

    <p id="project-status" role="status" aria-live="polite" class="sr-only" data-word={S.resultsWord}></p>
    <div id="project-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project) => {
          const categories = Array.isArray(project.category) ? project.category : [project.category];
          return (
            <div
              class="project-item"
              data-categories={categories.join('|')}
              data-tags={project.tags.join('|')}
              data-featured={project.featured ? 'true' : 'false'}
            >
              <ProjectCard project={project} withImage={false} categoryLabel={label(project.category)} locale={locale} />
            </div>
          );
        })
      }
    </div>
  </Section>

</Base>

<style>
  .chip {
    @apply inline-flex items-center gap-1.5 rounded-full border border-border bg-surface/60 px-3.5 py-1.5 text-sm text-muted transition-colors;
  }
  .chip:hover {
    @apply border-primary/60 text-fg;
  }
  .chip[aria-pressed='true'] {
    @apply border-primary font-semibold text-primary;
    background: var(--gradient-brand-soft);
  }
  .chip-sep {
    @apply text-border;
  }
  .chip-count {
    @apply inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-fg/10 px-1.5 py-0.5 text-xs font-semibold text-fg;
  }
  .chip[aria-pressed='true'] .chip-sep {
    @apply text-primary/40;
  }
  .chip[aria-pressed='true'] .chip-count {
    @apply bg-primary/15 text-primary;
  }
</style>

<script is:inline>
  (function () {
    var bar = document.getElementById('project-filter');
    var grid = document.getElementById('project-grid');
    if (!bar || !grid) return;
    var chips = bar.querySelectorAll('[data-filter]');
    var items = grid.querySelectorAll('.project-item');
    var statusEl = document.getElementById('project-status');
    var filterActive = false;
    function announce() {
      if (!statusEl) return;
      var n = 0;
      for (var k = 0; k < items.length; k++) if (!items[k].hidden) n++;
      statusEl.textContent = n + ' ' + (statusEl.getAttribute('data-word') || '');
    }

    function set(val) {
      filterActive = true;
      for (var i = 0; i < chips.length; i++) {
        chips[i].setAttribute(
          'aria-pressed',
          String(chips[i].getAttribute('data-filter') === val)
        );
      }
      var tag = val.indexOf('tag:') === 0 ? val.slice(4) : null;
      for (var j = 0; j < items.length; j++) {
        var show;
        if (tag)
          show = (items[j].getAttribute('data-tags') || '').split('|').indexOf(tag) !== -1;
        else {
          var projectCategories = (items[j].getAttribute('data-categories') || '').split('|');
          show = projectCategories.indexOf(val) !== -1;
        }
        items[j].hidden = !show;
      }
      announce();
    }

    function showFeatured() {
      filterActive = false;
      for (var i = 0; i < chips.length; i++) {
        chips[i].setAttribute('aria-pressed', 'false');
      }
      for (var j = 0; j < items.length; j++) {
        items[j].hidden = items[j].getAttribute('data-featured') !== 'true';
      }
      announce();
    }

    // Show featured projects by default
    showFeatured();

    for (var i = 0; i < chips.length; i++) {
      chips[i].addEventListener('click', function () {
        set(this.getAttribute('data-filter'));
      });
    }
  })();
</script>
