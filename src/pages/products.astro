---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getEntry, render } from 'astro:content';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const page = await getEntry('pages', 'products');
const { Content } = await render(page!);
---

<Base title={page!.data.title} description={page!.data.description}>
  <PageHeader eyebrow="Offerings" title="Products" lead={page!.data.description} />

  <article class="prose-content max-w-3xl">
    <Content />
  </article>

  <div class="mt-12 flex flex-wrap items-center gap-3 rounded-2xl border border-border bg-surface p-6" style="box-shadow: var(--shadow-elevate);">
    <p class="w-full display-3 text-lg">Questions about a product?</p>
    <a class="btn-primary" href={`${base}/contact`}>Get in touch</a>
    <a class="btn-ghost" href={site.socials.github} rel="noopener">Browse on GitHub</a>
  </div>
</Base>
