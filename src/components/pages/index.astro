const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (href: string) => `${base}${localePath(locale, href)}/`.replace(/\/+$/, '/');

const home = await getEntry('pages', pageEntryId(locale, 'home'));
const { Content } = await render(home!);

// Only render posts whose date has arrived — future-dated posts stay hidden
// until a (re)build after their date (see the weekly cron in deploy.yml).
const posts = (await getCollection('blog', ({ data }) => data.lang === locale && !data.draft && data.date.valueOf() <= Date.now()))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const testimonials = (await getCollection('testimonials'))
  .map((t) => t.data)
  .filter((t) => !t.placeholder);

const whatWeDo = S.whatWeDo;

// "The stack we steward" word-marks.
const stack = ['OpenVoiceOS', 'HiveMind'];
---

<Base title={home!.data.title} description={home!.data.description} locale={locale}>
  <Hero link={link} locale={locale}>
    <Content />
  </Hero>

  <!-- What we do -->
  <Section eyebrow={S.whatWeDoEyebrow} title={S.whatWeDoTitle} lead={S.whatWeDoLead}>
    <div class="grid gap-5 sm:grid-cols-2">
      {
        whatWeDo.map((item, i) => (
          <div
            class:list={['card-hover reveal', item.wide && 'sm:col-span-2']}
            data-reveal
            data-reveal-delay={i * 70}
          >
            <span class="icon-chip mb-4"><Icon name={item.icon} /></span>
            <h3 class="display-3 text-lg">{item.title}</h3>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted">{item.body}</p>
            {item.wide && (
              <a
                class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
                href={link('/services')}
              >
                {S.dataServices} <Icon name="arrow" class="h-4 w-4" />
              </a>
            )}
          </div>
        ))
      }
    </div>
    <p class="mt-8 text-muted">
      {S.creators}
      <a class="font-medium text-primary hover:underline" href="https://jarbashivemind.github.io/HiveMind-community-docs/" rel="noopener">HiveMind</a>
      {S.contributors}
      <a class="font-medium text-primary hover:underline" href={site.socials.openvoiceos} rel="noopener">OpenVoiceOS</a>.
    </p>
  </Section>

  <hr class="rule-gradient" />

  <!-- The stack we build on -->
  <section class="py-12">
    <p class="eyebrow mb-6 justify-center text-center reveal" data-reveal>{S.stackEyebrow}</p>
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4 reveal" data-reveal data-reveal-delay="80">
      {
        stack.map((name) => (
          <span class="font-display text-2xl uppercase tracking-[0.18em] text-fg/70 transition-colors hover:text-fg sm:text-3xl">
            {name}
          </span>
        ))
      }
    </div>
  </section>

  <!-- Miro & Dii — universal voices (OpenVoiceOS partnership) -->
  <section
    class="my-4 overflow-hidden rounded-3xl border border-border px-6 py-12 reveal"
    data-reveal
    style="background: var(--gradient-brand-soft);"
  >
    <p class="eyebrow mb-3">{S.ovosEyebrow}</p>
    <h2 class="display-2">{S.ovosTitle}</h2>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-fg/85">
      <strong>Miro</strong>{S.ovosBody1}<strong>Dii</strong> {S.ovosBody}
      <strong>{S.ovosTiny}</strong> {S.ovosBody2}
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn-primary" href={`${base}/demo`}>{S.hear}</a>
      <a
        class="btn-ghost"
        href="https://huggingface.co/collections/TigreGotico/phoonnx-tts-models"
        rel="noopener">{S.browseHf}</a
      >
      <a class="btn-ghost" href={link('/services')}>{S.requestVoice}</a>
    </div>
  </section>

  <!-- Featured projects + a flagship dataset -->
  <Section
    eyebrow={S.featuredEyebrow}
    title={S.featuredTitle}
    lead={S.featuredLead}
    class="surface-alt -mx-6 rounded-3xl px-6"
  >
    <p class="max-w-3xl text-muted">{S.featuredBody}</p>
    <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
      <a class="inline-flex items-center gap-1 font-medium text-primary hover:underline" href={link('/projects')}>
        {S.browseAll} <Icon name="arrow" class="h-4 w-4" />
      </a>
      <a class="inline-flex items-center gap-1 font-medium text-primary hover:underline" href={site.socials.huggingface} rel="noopener">
        {S.datasetsModels} <Icon name="arrow" class="h-4 w-4" />
      </a>
    </p>
  </Section>

  <!-- Games teaser -->
  <Section eyebrow={S.playEyebrow} title={S.playTitle} lead={S.playLead}>
    <div class="flex flex-wrap items-center gap-3 reveal" data-reveal>
      <span class="icon-chip"><Icon name="scroll" /></span>
      <span class="icon-chip"><Icon name="spark" /></span>
      <span class="icon-chip"><Icon name="waveform" /></span>
      <a
        class="ml-auto inline-flex items-center gap-1 font-medium text-primary hover:underline"
        href={link('/games')}
      >
        {S.exploreGames} <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
  </Section>

  <!-- Latest posts -->
  <Section eyebrow={S.blogEyebrow} title={S.blogTitle}>
    <ul class="grid gap-5 sm:grid-cols-3">
      {
        posts.map((post, i) => (
          <li class="reveal" data-reveal data-reveal-delay={i * 70}>
            <a href={`${base}${blogPath(locale, blogSlug(post.id))}/`} class="card-hover group flex h-full flex-col">
              <time
                class="font-display text-xs uppercase tracking-[0.2em] text-muted"
                datetime={post.data.date.toISOString()}
              >
                {post.data.date.toLocaleDateString(S.dateLocale, {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
              <h3 class="mt-2 display-3 text-base group-hover:text-primary">
                {post.data.title}
              </h3>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-8">
      <a class="inline-flex items-center gap-1 font-medium text-primary hover:underline" href={link('/blog')}>
        {S.readBlog} <Icon name="arrow" class="h-4 w-4" />
      </a>
    </p>
  </Section>

  <!-- Testimonials -->
  <Section
    eyebrow={S.testimonialsEyebrow}
    title={S.testimonialsTitle}
    lead={S.testimonialsLead}
    class="surface-alt -mx-6 rounded-3xl px-6"
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        testimonials.map((t, i) => (
          <figure
            class:list={['card reveal', t.placeholder && 'border-dashed']}
            data-reveal
            data-reveal-delay={i * 70}
          >
            {t.placeholder && <span class="badge mb-3">Placeholder — quote pending</span>}
            <blockquote class="text-sm italic leading-relaxed text-muted">
              &ldquo;{t.quotes?.[locale] ?? t.quote}&rdquo;
            </blockquote>
            <figcaption class="mt-4">
              <span class="block text-sm font-semibold">{t.author}</span>
              {t.url ? (
                <a href={t.url} class="text-xs text-primary hover:underline" rel="noopener">
                  {t.org}
                </a>
              ) : (
                <span class="text-xs text-muted">{t.org}</span>
              )}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Section>

  <!-- CTA -->
  <section class="relative my-10 overflow-hidden rounded-3xl border border-border px-6 py-16 text-center">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-90"
      style="background: var(--gradient-brand-soft);"
      aria-hidden="true"
    >
    </div>
    <p class="eyebrow mb-4 justify-center reveal" data-reveal>{S.ctaEyebrow}</p>
    <h2 class="display-2 reveal" data-reveal data-reveal-delay="60">
      {S.ctaTitle}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-muted reveal" data-reveal data-reveal-delay="120">
      {S.ctaBody}
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3 reveal" data-reveal data-reveal-delay="180">
      <a class="btn-primary" href={link('/contact')}>{S.getInTouch}</a>
      <a class="btn-ghost" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </section>
</Base>
