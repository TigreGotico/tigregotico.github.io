    "vat": "Btw-nummer"
  },
  fr: {
    "eyebrow": "Dites bonjour",
    "title": "Contact",
    "subject": "Demande de projet — TigreGótico",
    "body": "Bonjour TigreGótico,\n\nJe souhaiterais aborder :\n- Ce que je veux construire :\n- Langues / plateformes concernées :\n- Calendrier :\n\nMerci !",
    "emailUs": "Écrivez-nous directement",
    "compose": "Rédiger une demande",
    "noForms": "Aucun formulaire web, aucun traceur, aucun backend tiers — votre message arrive directement dans notre boîte de réception.",
    "findWork": "Découvrez notre travail",
    "registered": "Siège social",
    "vat": "N° de TVA"
  },
  it: {
    "eyebrow": "Salutaci",
    "title": "Contatti",
    "subject": "Richiesta di progetto — TigreGótico",
    "body": "Ciao TigreGótico,\n\nvorrei parlare di:\n- Cosa voglio realizzare:\n- Lingue / piattaforme coinvolte:\n- Tempistiche:\n\nGrazie!",
    "emailUs": "Scrivici direttamente",
    "compose": "Componi una richiesta",
    "noForms": "Niente moduli web, niente tracker, nessun backend di terze parti — il tuo messaggio arriva direttamente nella nostra casella di posta.",
