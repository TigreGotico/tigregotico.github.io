---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const page = await getEntry('pages', 'products');
const { Content } = await render(page!);
---

<Base title={page!.data.title} description={page!.data.description}>
  <header class="mb-10 max-w-2xl">
    <p class="eyebrow mb-2">Offerings</p>
    <h1 class="font-serif text-4xl font-bold">Products</h1>
    <p class="mt-3 text-muted">{page!.data.description}</p>
  </header>

  <article class="prose-content max-w-3xl">
    <Content />
  </article>

  <div class="mt-12 flex flex-wrap gap-3 rounded-xl border border-border bg-surface p-6">
    <p class="w-full font-serif text-lg font-semibold">Questions about a product?</p>
    <a class="btn-primary" href={`${base}/contact`}>Get in touch</a>
    <a class="btn-ghost" href={site.socials.github} rel="noopener">Browse on GitHub</a>
  </div>
</Base>
