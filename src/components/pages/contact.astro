    "title": "Contacto",
    "subject": "Consulta de proyecto — TigreGótico",
    "body": "Hola TigreGótico,\n\nMe gustaría hablar sobre:\n- Lo que quiero construir:\n- Idiomas / plataformas implicadas:\n- Plazo:\n\n¡Gracias!",
    "emailUs": "Escríbanos directamente",
    "compose": "Redactar una consulta",
    "noForms": "Sin formularios web, sin rastreadores, sin backend de terceros: su mensaje llega directamente a nuestra bandeja de entrada.",
    "findWork": "Encuentre nuestro trabajo",
    "registered": "Domicilio social",
    "vat": "NIF"
  },
  de: {
    "eyebrow": "Sagen Sie Hallo",
    "title": "Kontakt",
    "subject": "Projektanfrage — TigreGótico",
    "body": "Hallo TigreGótico,\n\nich würde gerne Folgendes besprechen:\n- Was ich entwickeln möchte:\n- Beteiligte Sprachen / Plattformen:\n- Zeitplan:\n\nVielen Dank!",
    "emailUs": "Schreiben Sie uns direkt",
    "compose": "Eine Anfrage verfassen",
    "noForms": "Keine Webformulare, keine Tracker, kein Drittanbieter-Backend – Ihre Nachricht gelangt direkt in unseren Posteingang.",
    "findWork": "Finden Sie unsere Arbeit",
    "registered": "Firmensitz",
    "vat": "USt-IdNr."
  },
  nl: {
    "eyebrow": "Zeg hallo",
    "title": "Contact",
    "subject": "Projectaanvraag — TigreGótico",
    "body": "Hallo TigreGótico,\n\nIk zou graag het volgende bespreken:\n- Wat ik wil bouwen:\n- Betrokken talen / platforms:\n- Tijdlijn:\n\nBedankt!",
    "emailUs": "Mail ons rechtstreeks",
    "compose": "Een aanvraag opstellen",
