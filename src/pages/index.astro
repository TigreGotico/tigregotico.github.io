---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getEntry, getCollection, render } from 'astro:content';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (href: string) => `${base}${href}`;

const home = await getEntry('pages', 'home');
const { Content } = await render(home!);

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .map((p) => p.data);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const whatWeDo = [
  {
    title: 'Privacy-first voice assistants',
    body: 'On-device OpenVoiceOS deployments that keep audio and data on your own hardware — GDPR-compliant by design.',
  },
  {
    title: 'Custom offline TTS voices',
    body: 'High-quality text-to-speech voices trained for your language or brand, running fully offline.',
  },
  {
    title: 'Minority & Lusophone speech tech',
    body: 'Phonemization, STT, and TTS for under-served languages that mainstream tools overlook.',
  },
  {
    title: 'HiveMind device meshes',
    body: 'Distributed voice across satellites and hubs with fine-grained permissions and no central cloud.',
  },
];
---

<Base title={home!.data.title} description={home!.data.description}>
  <!-- Hero -->
  <section class="motion-safe-fade relative overflow-hidden rounded-2xl border border-border bg-surface px-6 py-16 sm:px-12 sm:py-20">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-60"
      style="background: radial-gradient(60% 80% at 80% 10%, rgb(var(--color-accent) / 0.18), transparent 70%), radial-gradient(50% 60% at 10% 90%, rgb(var(--color-primary) / 0.16), transparent 70%);"
      aria-hidden="true"
    >
    </div>
    <p class="eyebrow mb-3">Privacy-First Voice AI</p>
    <h1 class="max-w-3xl font-serif text-4xl font-bold leading-tight sm:text-5xl">
      Voice technology that respects your data.
    </h1>
    <div class="prose-content mt-5 max-w-2xl text-lg">
      <Content />
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn-primary" href={link('/contact')}>Start a project</a>
      <a class="btn-ghost" href={link('/projects')}>Explore our work</a>
    </div>
  </section>

  <!-- What we do -->
  <Section
    eyebrow="What we do"
    title="FOSS voice technology, end to end"
    lead="As core maintainers of OpenVoiceOS and HiveMind, we build the whole stack — and we keep it open."
  >
    <div class="grid gap-4 sm:grid-cols-2">
      {
        whatWeDo.map((item) => (
          <div class="card">
            <h3 class="font-serif text-lg font-semibold">{item.title}</h3>
            <p class="mt-2 text-sm text-muted">{item.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Featured projects -->
  <Section
    eyebrow="Featured"
    title="Projects we maintain"
    lead="A selection of the open-source platforms and tools we build and steward."
  >
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((project) => <ProjectCard project={project} withImage />)}
    </div>
    <p class="mt-6">
      <a class="font-medium text-primary hover:underline" href={link('/projects')}
        >See all projects &rarr;</a
      >
    </p>
  </Section>

  <!-- Latest posts -->
  <Section eyebrow="From the blog" title="Latest writing">
    <ul class="grid gap-4 sm:grid-cols-3">
      {
        posts.map((post) => (
          <li>
            <a href={`${base}/blog/${post.id}`} class="card-hover block h-full">
              <time
                class="text-xs uppercase tracking-wide text-muted"
                datetime={post.data.date.toISOString()}
              >
                {post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
              <h3 class="mt-2 font-serif text-base font-semibold">
                {post.data.title}
              </h3>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-6">
      <a class="font-medium text-primary hover:underline" href={link('/blog')}
        >Read the blog &rarr;</a
      >
    </p>
  </Section>

  <!-- CTA -->
  <section class="mt-8 rounded-2xl border border-primary/40 bg-surface px-6 py-12 text-center">
    <h2 class="font-serif text-2xl font-semibold sm:text-3xl">
      Have a voice project in mind?
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-muted">
      Talk to the people who maintain the stack. No data brokers, no lock-in — just
      private, open voice technology built to last.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a class="btn-primary" href={link('/contact')}>Get in touch</a>
      <a class="btn-ghost" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </section>
</Base>
