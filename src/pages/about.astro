---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { site } from '../data/site';

const page = await getEntry('pages', 'about');
const { Content } = await render(page!);
---

<Base title={page!.data.title} description={page!.data.description}>
  <header class="mb-10 max-w-2xl">
    <p class="eyebrow mb-2">Who we are</p>
    <h1 class="font-serif text-4xl font-bold">About TigreGótico</h1>
    <p class="mt-3 text-muted">{page!.data.description}</p>
  </header>

  <div class="grid gap-8 lg:grid-cols-[1fr_16rem]">
    <article class="prose-content max-w-3xl">
      <Content />
    </article>

    <aside class="h-max rounded-xl border border-border bg-surface p-6 text-sm">
      <p class="font-serif text-base font-semibold">Verify our work</p>
      <ul class="mt-3 space-y-2">
        <li>
          <a class="text-primary hover:underline" href={site.socials.github} rel="noopener"
            >GitHub organization</a
          >
        </li>
        <li>
          <a class="text-primary hover:underline" href={site.socials.huggingface} rel="noopener"
            >Hugging Face</a
          >
        </li>
        <li>
          <a class="text-primary hover:underline" href={site.socials.openvoiceos} rel="noopener"
            >openvoiceos.org</a
          >
        </li>
      </ul>
    </aside>
  </div>
</Base>
