---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getEntry, render } from 'astro:content';
import { site } from '../data/site';

const page = await getEntry('pages', 'about');
const { Content } = await render(page!);
---

<Base title={page!.data.title} description={page!.data.description}>
  <PageHeader eyebrow="Who we are" title="About TigreGótico" lead={page!.data.description} />

  <div class="grid gap-8 lg:grid-cols-[1fr_16rem]">
    <article class="prose-content max-w-3xl">
      <Content />
    </article>

    <aside class="card h-max text-sm">
      <p class="display-3 text-base">Verify our work</p>
      <ul class="mt-3 space-y-2">
        <li>
          <a class="text-primary hover:underline" href={site.socials.github} rel="noopener"
            >GitHub organization</a
          >
        </li>
        <li>
          <a class="text-primary hover:underline" href={site.socials.huggingface} rel="noopener"
            >Hugging Face</a
          >
        </li>
        <li>
          <a class="text-primary hover:underline" href={site.socials.openvoiceos} rel="noopener"
            >openvoiceos.org</a
          >
        </li>
      </ul>
    </aside>
  </div>
</Base>
