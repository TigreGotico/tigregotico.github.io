---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Page Not Found" description="The page you are looking for does not exist.">
  <section class="relative overflow-hidden py-24 text-center">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-80"
      style="background: radial-gradient(40% 50% at 50% 30%, rgb(var(--grad-via) / 0.16), transparent 65%);"
      aria-hidden="true"
    >
    </div>
    <p class="eyebrow mb-5 justify-center">Signal lost</p>
    <p class="text-gradient font-serif text-7xl font-bold sm:text-8xl">404</p>
    <h1 class="mt-4 display-2">This page is off the mesh.</h1>
    <p class="mx-auto mt-4 max-w-md text-muted">
      The page you are looking for does not exist — it may have moved, or never
      tuned in at all.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn-primary" href={`${base}/`}>
        <Icon name="home" class="h-4 w-4" /> Back home
      </a>
      <a class="btn-ghost" href={`${base}/projects`}>Browse projects</a>
    </div>
  </section>
</Base>
