---
import { site } from '../data/site';
import { ui, localePath, translatedPaths, locales, blogLocales, type Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  /** Per-page OG image, root-relative (e.g. /og-blog.png) or absolute URL. */
  image?: string;
  /** 'website' for pages, 'article' for blog posts. */
  type?: 'website' | 'article';
  /** Extra JSON-LD object (e.g. BlogPosting) merged alongside Organization. */
  jsonLd?: Record<string, unknown>;
  publishedTime?: string;
  modifiedTime?: string;
  /** Exclude the page from search indexes (e.g. the 404 page). */
  noindex?: boolean;
  locale?: Locale;
}

const {
  title,
  description = site.description,
  image = site.defaultOgImage,
  type = 'website',
  jsonLd,
  publishedTime,
  modifiedTime,
  noindex = false,
  locale = 'en',
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : site.title;

// Canonical = current page resolved against the configured site origin.
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

// hreflang alternates for pages that exist in both locales.
const baseNoSlash = import.meta.env.BASE_URL.replace(/\/$/, '');
const herePath = Astro.url.pathname.replace(/\/$/, '');
const sitePath =
  (herePath.startsWith(baseNoSlash) ? herePath.slice(baseNoSlash.length) : herePath) || '/';
const enPath = sitePath.replace(/^\/(pt|es|de|nl|fr|it|ru|ar|fa|hi|zh|ko|ja)(?=\/|$)/, '') || '/';
const withSlash = (p: string) => (p.endsWith('/') ? p : p + '/');
const abs = (path: string) => new URL(baseNoSlash + withSlash(path), Astro.site ?? site.url).href;
// Blog posts exist only in en + pt; other pages exist in every locale.
const isBlogPost = /^\/blog\/.+/.test(enPath);
const altLocales: Locale[] = isBlogPost ? blogLocales : locales;
const alternates =
  translatedPaths.includes(enPath) || isBlogPost
    ? [
        ...altLocales.map((l) => ({ hreflang: ui[l].lang, href: abs(localePath(l, enPath)) })),
        { hreflang: 'x-default', href: abs(enPath) },
      ]
    : [];

// Resolve OG image to an absolute URL. Astro-processed assets (under the
// configured base, e.g. /_astro/...) and external URLs are
// used as-is; bare root-relative paths get the base prefixed.
const baseUrl = import.meta.env.BASE_URL;
const ogImagePath =
  image.startsWith('http') || image.startsWith(baseUrl)
    ? image
    : baseUrl.replace(/\/$/, '') + image;
const ogImage = ogImagePath.startsWith('http')
  ? ogImagePath
  : new URL(ogImagePath, Astro.site ?? site.url).href;

// Same absolute-URL treatment as the OG image above.
const logoPath = site.logo.startsWith('http')
  ? site.logo
  : baseUrl.replace(/\/$/, '') + site.logo;
const logoUrl = logoPath.startsWith('http')
  ? logoPath
  : new URL(logoPath, Astro.site ?? site.url).href;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  email: site.email,
  vatID: site.nif,
  logo: logoUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.lines[0],
    postalCode: site.address.postalCode,
    addressLocality: site.address.locality,
    addressCountry: site.address.country,
  },
  sameAs: [
    site.socials.github,
    site.socials.huggingface,
    site.socials.openvoiceos,
    site.socials.linkedin,
  ],
};

// BreadcrumbList for nested pages (blog posts, section pages). The site
// root gets no breadcrumb trail — there's nothing to trail from.
const navLabelKeyByPath: Record<string, keyof (typeof ui)['en']['nav']> = {
  '/about': 'about',
  '/blog': 'blog',
  '/projects': 'projects',
  '/services': 'services',
  '/games': 'games',
  '/contact': 'contact',
};
const breadcrumbSegments = sitePath === '/' ? [] : enPath.split('/').filter(Boolean);
const breadcrumbLd =
  breadcrumbSegments.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: (() => {
          const items: { name: string; url: string }[] = [
            { name: ui[locale].nav.home, url: abs(localePath(locale, '/')) },
          ];
          let acc = '';
          breadcrumbSegments.forEach((seg, i) => {
            acc += `/${seg}`;
            const isLast = i === breadcrumbSegments.length - 1;
            const navKey = navLabelKeyByPath[acc];
            const name =
              isLast && isBlogPost && title
                ? title
                : navKey
                  ? ui[locale].nav[navKey]
                  : seg;
            items.push({ name, url: abs(localePath(locale, acc)) });
          });
          return items.map((it, idx) => ({
            '@type': 'ListItem',
            position: idx + 1,
            name: it.name,
            item: it.url,
          }));
        })(),
      }
    : null;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
{!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={ui[locale].locale} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(organizationLd)}
/>
{
  jsonLd && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  )
}
{
  breadcrumbLd && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbLd)}
    />
  )
}
