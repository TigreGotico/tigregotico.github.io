---
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import { getEntry, render } from 'astro:content';
import { pageEntryId, localePath, type Locale } from '../../i18n';

interface Props { locale?: Locale }
const locale: Locale = Astro.props.locale ?? 'en';

const S = {
  en: {
    eyebrow: 'Play',
    title: 'Text & Voice Games',
    whatWeMake: 'What we make',
    whatWeMakeTitle: 'From classics to generative worlds',
    howToPlayEyebrow: 'How to play',
    howToPlayTitle: 'Command line or voice — your call',
    more: 'More titles are in active development — follow along on the blog.',
    engines: 'Our engines',
    enginesTitle: 'Under the hood',
    tnalagmes:
      'the framework behind dozens of titles, from Oregon Trail to Lunar Lander. Handles game state, voice I/O, and NLP so authors focus on story and rules.',
    storyforge:
      'Our engine for story-driven interactive fiction — branching narratives where choices matter and dice-based resolution keeps outcomes honest. Built voice-first, with blind and low-vision players as the primary audience.',
    pyfrotz:
      'Python wrapper around the Frotz Z-machine interpreter. Runs classic Z3/Z5/Z8 story files by voice, with built-in auto-translation so Infocom and community-made games reach new languages and voice-first audiences.',
    cta: 'Want a voice game built — or your world voice-enabled?',
    contact: 'Get in touch',
    blog: 'Read the blog',
    kinds: [
      {
        icon: 'scroll',
        title: 'Classic interactive fiction',
        body: 'Parser-style text adventures in the Infocom lineage — Z-machine stories and the classics — narrated and controlled by voice or keyboard.',
      },
      {
        icon: 'spark',
        title: 'LLM-powered generative worlds',
        body: 'Open-ended worlds where a language model improvises the story, characters, and choices around you — a fresh adventure every play-through.',
      },
      {
        icon: 'waveform',
        title: 'Audio-first & accessible',
        body: 'Built for ears, not eyes. Screen-reader-friendly in the terminal and fully voice-driven on the Open Voice Operating System — designed with blind players.',
      },
    ],
    howToPlay: [
      { icon: 'cpu', title: 'In your command line', body: 'A keyboard-and-text client you can run anywhere a terminal runs.' },
      { icon: 'mic', title: 'By voice', body: 'Hands-free on the Open Voice Operating System and HiveMind — just talk and listen.' },
    ],
  },
  pt: {
    eyebrow: 'Jogar',
    title: 'Jogos de Texto e Voz',
    whatWeMake: 'O que fazemos',
    whatWeMakeTitle: 'Dos clássicos aos mundos generativos',
    howToPlayEyebrow: 'Como jogar',
    howToPlayTitle: 'Linha de comandos ou voz — a escolha é sua',
    more: 'Há mais títulos em desenvolvimento ativo — acompanhe no blogue.',
    engines: 'Os nossos motores',
    enginesTitle: 'Por baixo do capô',
    tnalagmes:
      'a framework por detrás de dezenas de títulos, do Oregon Trail ao Lunar Lander. Trata do estado do jogo, da entrada e saída por voz e do NLP, para que os autores se concentrem na história e nas regras.',
    storyforge:
      'O nosso motor para ficção interativa orientada à história — narrativas ramificadas onde as escolhas contam e a resolução por dados mantém os desfechos honestos. Construído voz-primeiro, com jogadores cegos e de baixa visão como público principal.',
    pyfrotz:
      'Wrapper Python do interpretador Frotz de Z-machine. Corre ficheiros clássicos Z3/Z5/Z8 por voz, com tradução automática integrada para que os jogos da Infocom e da comunidade cheguem a novas línguas e a públicos voz-primeiro.',
    cta: 'Quer um jogo de voz feito à medida — ou o seu mundo com voz?',
    contact: 'Fale connosco',
    blog: 'Ler o blogue',
    kinds: [
      {
        icon: 'scroll',
        title: 'Ficção interativa clássica',
        body: 'Aventuras de texto com parser, na linhagem da Infocom — histórias Z-machine e os clássicos — narradas e controladas por voz ou teclado.',
      },
      {
        icon: 'spark',
        title: 'Mundos generativos com LLMs',
        body: 'Mundos abertos onde um modelo de linguagem improvisa a história, as personagens e as escolhas à sua volta — uma aventura nova em cada partida.',
      },
      {
        icon: 'waveform',
        title: 'Áudio-primeiro e acessível',
        body: 'Feito para ouvidos, não para olhos. Compatível com leitores de ecrã no terminal e totalmente controlável por voz no Open Voice Operating System — desenhado com jogadores cegos.',
      },
    ],
    howToPlay: [
      { icon: 'cpu', title: 'Na linha de comandos', body: 'Um cliente de teclado e texto que corre onde quer que um terminal corra.' },
      { icon: 'mic', title: 'Por voz', body: 'Em mãos-livres no Open Voice Operating System e no HiveMind — basta falar e ouvir.' },
    ],
  },
  es: {
    "eyebrow": "Jugar",
    "title": "Juegos de Texto y Voz",
    "whatWeMake": "Lo que creamos",
    "whatWeMakeTitle": "De los clásicos a los mundos generativos",
    "howToPlayEyebrow": "Cómo jugar",
    "howToPlayTitle": "Línea de comandos o voz: usted decide",
    "more": "Hay más títulos en desarrollo activo: siga su evolución en el blog.",
    "engines": "Nuestros motores",
    "enginesTitle": "Bajo el capó",
    "tnalagmes": "el framework detrás de decenas de títulos, desde Oregon Trail hasta Lunar Lander. Gestiona el estado del juego, la entrada y salida por voz y el NLP, para que los autores se centren en la historia y las reglas.",
    "storyforge": "Nuestro motor para ficción interactiva orientada a la historia: narrativas ramificadas donde las decisiones importan y la resolución basada en dados mantiene los desenlaces honestos. Construido con la voz primero, con jugadores ciegos y de baja visión como público principal.",
    "pyfrotz": "Wrapper de Python del intérprete Frotz de Z-machine. Ejecuta por voz los clásicos ficheros de historia Z3/Z5/Z8, con traducción automática integrada para que los juegos de Infocom y de la comunidad lleguen a nuevos idiomas y a públicos donde la voz es lo primero.",
    "cta": "¿Quiere un juego de voz hecho a medida, o dotar de voz a su mundo?",
    "contact": "Póngase en contacto",
    "blog": "Leer el blog",
    "kinds": [{"icon": "scroll", "title": "Ficción interactiva clásica", "body": "Aventuras de texto con parser, en la línea de Infocom: historias Z-machine y los clásicos, narradas y controladas por voz o teclado."}, {"icon": "spark", "title": "Mundos generativos impulsados por LLM", "body": "Mundos abiertos donde un modelo de lenguaje improvisa la historia, los personajes y las decisiones a su alrededor: una aventura nueva en cada partida."}, {"icon": "waveform", "title": "Audio primero y accesible", "body": "Hecho para los oídos, no para los ojos. Compatible con lectores de pantalla en el terminal y totalmente controlable por voz en el Open Voice Operating System: diseñado con jugadores ciegos."}],
    "howToPlay": [{"icon": "cpu", "title": "En su línea de comandos", "body": "Un cliente de teclado y texto que puede ejecutar en cualquier lugar donde funcione un terminal."}, {"icon": "mic", "title": "Por voz", "body": "Manos libres en el Open Voice Operating System y HiveMind: basta con hablar y escuchar."}]
  },
  de: {
    "eyebrow": "Spielen",
    "title": "Text- und Sprachspiele",
    "whatWeMake": "Was wir schaffen",
    "whatWeMakeTitle": "Von Klassikern bis zu generativen Welten",
    "howToPlayEyebrow": "So wird gespielt",
    "howToPlayTitle": "Befehlszeile oder Stimme — Sie entscheiden",
    "more": "Weitere Titel sind in aktiver Entwicklung — verfolgen Sie es im Blog.",
    "engines": "Unsere Engines",
    "enginesTitle": "Unter der Haube",
    "tnalagmes": "das Framework hinter Dutzenden von Titeln, von Oregon Trail bis Lunar Lander. Es verwaltet den Spielzustand, die Sprachein- und -ausgabe sowie NLP, damit sich die Autoren auf Handlung und Regeln konzentrieren können.",
    "storyforge": "Unsere Engine für handlungsgetriebene interaktive Fiktion — verzweigte Erzählungen, in denen Entscheidungen zählen und würfelbasierte Auflösung für ehrliche Ausgänge sorgt. Sprachorientiert entwickelt, mit blinden und sehbehinderten Spielern als primärer Zielgruppe.",
    "pyfrotz": "Python-Wrapper um den Frotz-Z-Machine-Interpreter. Führt klassische Z3/Z5/Z8-Story-Dateien per Sprache aus, mit integrierter automatischer Übersetzung, damit Infocom- und Community-Spiele neue Sprachen und sprachorientierte Zielgruppen erreichen.",
    "cta": "Möchten Sie ein Sprachspiel entwickeln lassen — oder Ihre Welt sprachfähig machen?",
    "contact": "Kontakt aufnehmen",
    "blog": "Blog lesen",
    "kinds": [{"icon": "scroll", "title": "Klassische interaktive Fiktion", "body": "Textabenteuer im Parser-Stil in der Tradition von Infocom — Z-Machine-Geschichten und die Klassiker — erzählt und gesteuert per Stimme oder Tastatur."}, {"icon": "spark", "title": "LLM-gestützte generative Welten", "body": "Offene Welten, in denen ein Sprachmodell die Geschichte, die Charaktere und die Entscheidungen um Sie herum improvisiert — ein frisches Abenteuer bei jedem Durchgang."}, {"icon": "waveform", "title": "Audio-first und barrierefrei", "body": "Für die Ohren gemacht, nicht für die Augen. Screenreader-freundlich im Terminal und vollständig sprachgesteuert auf dem Open Voice Operating System — entwickelt mit blinden Spielern."}],
    "howToPlay": [{"icon": "cpu", "title": "In Ihrer Befehlszeile", "body": "Ein Tastatur-und-Text-Client, den Sie überall dort ausführen können, wo ein Terminal läuft."}, {"icon": "mic", "title": "Per Stimme", "body": "Freihändig auf dem Open Voice Operating System und HiveMind — einfach sprechen und zuhören."}]
  },
  nl: {
    "eyebrow": "Spelen",
    "title": "Tekst- en Spraakspellen",
    "whatWeMake": "Wat wij maken",
    "whatWeMakeTitle": "Van klassiekers tot generatieve werelden",
    "howToPlayEyebrow": "Hoe te spelen",
    "howToPlayTitle": "Opdrachtregel of spraak — u kiest",
    "more": "Er zijn meer titels in actieve ontwikkeling — volg het op de blog.",
    "engines": "Onze engines",
    "enginesTitle": "Onder de motorkap",
    "tnalagmes": "het framework achter tientallen titels, van Oregon Trail tot Lunar Lander. Het beheert de spelstatus, de spraakinvoer en -uitvoer en NLP, zodat auteurs zich op verhaal en regels kunnen richten.",
    "storyforge": "Onze engine voor verhaalgedreven interactieve fictie — vertakkende verhalen waar keuzes ertoe doen en dobbelsteengebaseerde afhandeling de afloop eerlijk houdt. Spraak-eerst gebouwd, met blinde en slechtziende spelers als het primaire publiek.",
    "pyfrotz": "Python-wrapper rond de Frotz Z-machine-interpreter. Draait klassieke Z3/Z5/Z8-verhaalbestanden via spraak, met ingebouwde automatische vertaling zodat spellen van Infocom en de gemeenschap nieuwe talen en spraak-eerst-publiek bereiken.",
    "cta": "Wilt u een spraakspel laten bouwen — of uw wereld spraakgestuurd maken?",
    "contact": "Neem contact op",
    "blog": "Lees de blog",
    "kinds": [{"icon": "scroll", "title": "Klassieke interactieve fictie", "body": "Tekstavonturen in parserstijl in de lijn van Infocom — Z-machine-verhalen en de klassiekers — verteld en bestuurd met spraak of toetsenbord."}, {"icon": "spark", "title": "Door LLM aangedreven generatieve werelden", "body": "Open werelden waar een taalmodel het verhaal, de personages en de keuzes om u heen improviseert — een verse avontuur bij elke speelbeurt."}, {"icon": "waveform", "title": "Audio-eerst en toegankelijk", "body": "Gemaakt voor de oren, niet voor de ogen. Schermlezervriendelijk in de terminal en volledig spraakgestuurd op het Open Voice Operating System — ontworpen met blinde spelers."}],
    "howToPlay": [{"icon": "cpu", "title": "In uw opdrachtregel", "body": "Een toetsenbord-en-tekstclient die u overal kunt draaien waar een terminal draait."}, {"icon": "mic", "title": "Met spraak", "body": "Handsfree op het Open Voice Operating System en HiveMind — gewoon praten en luisteren."}]
  },
  fr: {
    "eyebrow": "Jouer",
    "title": "Jeux de Texte et de Voix",
    "whatWeMake": "Ce que nous créons",
    "whatWeMakeTitle": "Des classiques aux mondes génératifs",
    "howToPlayEyebrow": "Comment jouer",
    "howToPlayTitle": "Ligne de commande ou voix — à vous de choisir",
    "more": "D'autres titres sont en développement actif — suivez cela sur le blog.",
    "engines": "Nos moteurs",
    "enginesTitle": "Sous le capot",
    "tnalagmes": "le framework derrière des dizaines de titres, d'Oregon Trail à Lunar Lander. Il gère l'état du jeu, l'entrée et la sortie vocales et le NLP, afin que les auteurs se concentrent sur l'histoire et les règles.",
    "storyforge": "Notre moteur pour la fiction interactive axée sur l'histoire — des récits ramifiés où les choix comptent et où la résolution par les dés préserve l'honnêteté des dénouements. Conçu voix d'abord, avec les joueurs aveugles et malvoyants comme public principal.",
    "pyfrotz": "Wrapper Python autour de l'interpréteur Frotz de Z-machine. Il exécute par la voix les fichiers d'histoire classiques Z3/Z5/Z8, avec traduction automatique intégrée pour que les jeux d'Infocom et de la communauté atteignent de nouvelles langues et des publics où la voix prime.",
    "cta": "Vous voulez un jeu vocal sur mesure — ou donner une voix à votre monde ?",
    "contact": "Prenez contact",
    "blog": "Lire le blog",
    "kinds": [{"icon": "scroll", "title": "Fiction interactive classique", "body": "Aventures textuelles à parseur dans la lignée d'Infocom — histoires Z-machine et les classiques — narrées et contrôlées à la voix ou au clavier."}, {"icon": "spark", "title": "Mondes génératifs propulsés par LLM", "body": "Des mondes ouverts où un modèle de langage improvise l'histoire, les personnages et les choix autour de vous — une aventure inédite à chaque partie."}, {"icon": "waveform", "title": "Audio d'abord et accessible", "body": "Conçu pour les oreilles, pas pour les yeux. Compatible avec les lecteurs d'écran dans le terminal et entièrement piloté à la voix sur l'Open Voice Operating System — conçu avec des joueurs aveugles."}],
    "howToPlay": [{"icon": "cpu", "title": "Dans votre ligne de commande", "body": "Un client clavier-et-texte que vous pouvez exécuter partout où fonctionne un terminal."}, {"icon": "mic", "title": "À la voix", "body": "Mains libres sur l'Open Voice Operating System et HiveMind — il suffit de parler et d'écouter."}]
  }
}[locale];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (href: string) => `${base}${localePath(locale, href)}/`;
const page = await getEntry('pages', pageEntryId(locale, 'games'));
const { Content } = await render(page!);

const kinds = S.kinds;
const howToPlay = S.howToPlay;
---

<Base title={page!.data.title} description={page!.data.description} locale={locale}>
  <PageHeader eyebrow={S.eyebrow} title={S.title} lead={page!.data.description} />

  <article class="prose-content max-w-3xl">
    <Content />
  </article>

  <Section eyebrow={S.whatWeMake} title={S.whatWeMakeTitle}>
    <div class="grid gap-5 sm:grid-cols-3">
      {
        kinds.map((k, i) => (
          <div class="card-hover reveal" data-reveal data-reveal-delay={i * 70}>
            <span class="icon-chip mb-4"><Icon name={k.icon} /></span>
            <h3 class="display-3 text-lg">{k.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{k.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section eyebrow={S.howToPlayEyebrow} title={S.howToPlayTitle}>
    <div class="grid gap-5 sm:grid-cols-2">
      {
        howToPlay.map((h, i) => (
          <div class="card reveal" data-reveal data-reveal-delay={i * 70}>
            <span class="icon-chip mb-4"><Icon name={h.icon} /></span>
            <h3 class="display-3 text-lg">{h.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{h.body}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-muted">{S.more}</p>
  </Section>

  <Section eyebrow={S.engines} title={S.enginesTitle}>
    <div class="grid gap-5 sm:grid-cols-3">
      <div class="card-hover reveal" data-reveal>
        <h3 class="display-3 text-lg">TNaLaGmes <span class="text-xs font-normal text-muted">beta</span></h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          <strong>T(oolbox) Na(tural) La(nguage) G(a)mes</strong> — {S.tnalagmes}
        </p>
        <a href="https://github.com/VoiceGamez/TNaLaGmes" class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary" rel="noopener">GitHub →</a>
      </div>
      <div class="card-hover reveal" data-reveal data-reveal-delay="70">
        <h3 class="display-3 text-lg">StoryForge <span class="text-xs font-normal text-muted">beta</span></h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          {S.storyforge}
        </p>
        <a href="https://github.com/VoiceGamez/story-forge" class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary" rel="noopener">GitHub →</a>
      </div>
      <div class="card-hover reveal" data-reveal data-reveal-delay="140">
        <h3 class="display-3 text-lg">pyFrotz</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          {S.pyfrotz}
        </p>
        <a href="https://github.com/VoiceGamez/pyFrotz" class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary" rel="noopener">GitHub →</a>
      </div>
    </div>
  </Section>

  <div
    class="mt-12 flex flex-wrap items-center gap-3 rounded-2xl border border-border bg-surface p-6"
    style="box-shadow: var(--shadow-elevate);"
  >
    <p class="w-full display-3 text-lg">{S.cta}</p>
    <a class="btn-primary" href={link('/contact')}>{S.contact}</a>
    <a class="btn-ghost" href={link('/blog')}>{S.blog}</a>
  </div>
</Base>
