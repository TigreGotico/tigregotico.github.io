---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import voices from '../data/phoonnx-voices.json';

const VOICE_LABELS: Record<string, string> = { Miro: 'Miro (male)', Dii: 'Dii (female)' };
const order: string[] = [];
const byVoice = new Map<string, typeof voices>();
for (const v of voices) {
  if (!byVoice.has(v.voice)) {
    byVoice.set(v.voice, []);
    order.push(v.voice);
  }
  byVoice.get(v.voice)!.push(v);
}
const groups = order.map((name) => ({
  label: VOICE_LABELS[name] || name,
  items: byVoice.get(name)!,
}));
---

<Base
  title="Voice demo — Miro & Dii"
  description="Try our trained phoonnx voices, Miro and Dii. Speech is synthesized entirely in your browser via ONNX — no server, no API. The eSpeak voices are piper / Home Assistant compatible."
>
  <PageHeader
    eyebrow="Try it in your browser"
    title="Speak with Miro & Dii"
    lead="Pick a voice, type a sentence, and hear it. Each voice is a tiny ~15.6M-parameter model, downloaded straight from Hugging Face and run entirely in your browser with onnxruntime-web — nothing is sent to a server."
  />

  <div class="mx-auto max-w-3xl">
    <div
      class="mb-6 rounded-xl border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-sm"
      role="note"
    >
      <strong>Preview models.</strong> These voices are a work in progress — they
      are still being trained and do <strong>not</strong> represent the final
      quality. Expect rough edges; they will keep improving.
    </div>

    <div class="card">
      <label class="eyebrow mb-2 block" for="voice">Voice</label>
      <select
        id="voice"
        class="w-full rounded-lg border border-border bg-elevated px-3 py-2 text-fg"
      >
        {
          groups.map((g) => (
            <optgroup label={g.label}>
              {g.items.map((v) => (
                <option value={v.id} data-ha={v.haCompatible ? '1' : '0'}>
                  {v.langLabel} · {v.haCompatible ? 'eSpeak (Home Assistant)' : 'Unicode'}
                </option>
              ))}
            </optgroup>
          ))
        }
      </select>

      <label class="eyebrow mb-2 mt-5 block" for="text">Text</label>
      <textarea
        id="text"
        rows="3"
        class="w-full rounded-lg border border-border bg-elevated px-3 py-2 text-fg"
      ></textarea>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <label class="block text-sm">
          <span class="mb-1 flex justify-between text-muted">
            <span>Speed</span><span id="speedVal" class="tabular-nums">1.00×</span>
          </span>
          <input id="speed" type="range" min="0.5" max="2" step="0.05" value="1"
            class="w-full accent-primary" />
        </label>
        <label class="block text-sm">
          <span class="mb-1 flex justify-between text-muted">
            <span>Volume</span><span id="volumeVal" class="tabular-nums">100%</span>
          </span>
          <input id="volume" type="range" min="0" max="2" step="0.05" value="1"
            class="w-full accent-primary" />
        </label>
      </div>

      <details class="mt-3 text-sm">
        <summary class="cursor-pointer text-muted hover:text-fg">Advanced (piper inference)</summary>
        <div class="mt-3 grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="mb-1 flex justify-between text-muted">
              <span>Variation (noise_scale)</span><span id="noiseVal" class="tabular-nums">0.667</span>
            </span>
            <input id="noise" type="range" min="0" max="1" step="0.01" value="0.667"
              class="w-full accent-primary" />
          </label>
          <label class="block">
            <span class="mb-1 flex justify-between text-muted">
              <span>Phoneme width (noise_w)</span><span id="noisewVal" class="tabular-nums">0.800</span>
            </span>
            <input id="noisew" type="range" min="0" max="1" step="0.01" value="0.8"
              class="w-full accent-primary" />
          </label>
        </div>
        <button id="reset" type="button" class="btn-ghost mt-3 text-xs">Reset to defaults</button>
      </details>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <button id="synth" class="btn btn-primary">Synthesize</button>
        <span id="status" class="text-sm text-muted" aria-live="polite"></span>
      </div>

      <div id="result" class="mt-5 hidden">
        <audio id="player" controls class="w-full"></audio>
        <a id="download" class="btn btn-ghost mt-3 inline-block" download="voice.wav">
          Download .wav
        </a>
      </div>
    </div>

    <div class="card mt-6 text-sm">
      <p class="display-3 text-base">Tiny models — runs on a potato 🥔</p>
      <p class="mt-2 text-muted">
        Each voice is a <strong>~15.6&nbsp;million-parameter</strong> model — small
        enough to run on a Raspberry&nbsp;Pi, a phone, or the very browser tab
        you're in right now, fully offline, no GPU and no cloud. While the big TTS
        labs brag about <em>billions</em> of parameters, we optimize for the
        opposite: <strong>tiny, fast, private, on-device</strong> voices that anyone
        can run and own.
      </p>
    </div>

    <div class="card mt-6 text-sm">
      <p class="display-3 text-base">Runs in your smart home</p>
      <p class="mt-2 text-muted">
        The eSpeak voices are <strong>piper / Home Assistant compatible</strong> — the
        exact <code>.onnx</code> you just heard drops into the
        <a class="text-primary hover:underline" href="https://www.home-assistant.io/voice_control/"
          rel="noopener">Home Assistant</a> piper add-on. One voice identity, on the
        web and on your local voice assistant. Read the story in
        <a
          class="text-primary hover:underline"
          href="/blog/2026-05-30-two-voices-every-language-miro-and-dii"
          >Two voices, every language</a
        >.
      </p>
      <p class="mt-2 text-muted">
        First synthesis of a voice downloads its model (~63 MB) from Hugging Face and
        caches it; later runs are instant and fully offline.
      </p>
    </div>

    <div class="card mt-6 text-sm">
      <p class="display-3 text-base">An OpenVoiceOS collaboration</p>
      <p class="mt-2 text-muted">
        Miro & Dii are built with
        <a class="text-primary hover:underline" href="https://www.openvoiceos.org" rel="noopener"
          >OpenVoiceOS</a
        >, the community non-profit voice platform — a collaboration in progress.
        The models are published openly on
        <a
          class="text-primary hover:underline"
          href="https://huggingface.co/collections/TigreGotico/phoonnx-tts-models"
          rel="noopener">Hugging Face</a
        > and run on the
        <a class="text-primary hover:underline" href="https://github.com/TigreGotico/phoonnx" rel="noopener"
          >phoonnx</a
        > engine. Everything here is FOSS and self-hostable.
      </p>
    </div>

    <div class="card mt-6 text-sm">
      <p class="display-3 text-base">Open source — train your own voice</p>
      <p class="mt-2 text-muted">
        <a class="text-primary hover:underline" href="https://github.com/TigreGotico/phoonnx" rel="noopener"
          >phoonnx</a
        > is fully open source, <strong>including the training code</strong> (see its
        <a
          class="text-primary hover:underline"
          href="https://github.com/TigreGotico/phoonnx/blob/dev/TRAINING.md"
          rel="noopener">TRAINING.md</a
        >). No gatekeeping, no API keys — the goal is to <strong>democratize
        text-to-speech for everyone</strong>, especially low-resource and minority
        languages. Build datasets and train your own voices with our
        <a class="text-primary hover:underline" href="https://github.com/TigreGotico/ml-notebooks" rel="noopener"
          >ml-notebooks</a
        > (TTS, wake-word, and intent-classifier pipelines).
      </p>
    </div>
  </div>

  <script>
    import voices from '../data/phoonnx-voices.json';
    import { loadVoice, synthesize, type VoiceEntry, type LoadedVoice } from '../scripts/phoonnx-tts';

    const byId = new Map(voices.map((v) => [v.id, v as VoiceEntry]));
    const sel = document.getElementById('voice') as HTMLSelectElement;
    const textEl = document.getElementById('text') as HTMLTextAreaElement;
    const btn = document.getElementById('synth') as HTMLButtonElement;
    const status = document.getElementById('status') as HTMLSpanElement;
    const result = document.getElementById('result') as HTMLDivElement;
    const player = document.getElementById('player') as HTMLAudioElement;
    const download = document.getElementById('download') as HTMLAnchorElement;

    const speed = document.getElementById('speed') as HTMLInputElement;
    const volume = document.getElementById('volume') as HTMLInputElement;
    const noise = document.getElementById('noise') as HTMLInputElement;
    const noisew = document.getElementById('noisew') as HTMLInputElement;
    const reset = document.getElementById('reset') as HTMLButtonElement;

    let loaded: LoadedVoice | null = null;
    const cache = new Map<string, LoadedVoice>();

    const DEFAULTS = { speed: '1', volume: '1', noise: '0.667', noisew: '0.8' };

    function syncLabels() {
      (document.getElementById('speedVal') as HTMLElement).textContent =
        `${(+speed.value).toFixed(2)}×`;
      (document.getElementById('volumeVal') as HTMLElement).textContent =
        `${Math.round(+volume.value * 100)}%`;
      (document.getElementById('noiseVal') as HTMLElement).textContent = (+noise.value).toFixed(3);
      (document.getElementById('noisewVal') as HTMLElement).textContent = (+noisew.value).toFixed(3);
    }
    for (const el of [speed, volume, noise, noisew]) el.addEventListener('input', syncLabels);
    reset.addEventListener('click', () => {
      speed.value = DEFAULTS.speed;
      volume.value = DEFAULTS.volume;
      noise.value = DEFAULTS.noise;
      noisew.value = DEFAULTS.noisew;
      syncLabels();
    });
    syncLabels();

    function prefill() {
      const v = byId.get(sel.value);
      if (v) textEl.value = v.sampleText;
    }
    sel.addEventListener('change', prefill);
    prefill();

    btn.addEventListener('click', async () => {
      const entry = byId.get(sel.value);
      if (!entry) return;
      const text = textEl.value.trim();
      if (!text) return;
      btn.disabled = true;
      try {
        if (cache.has(entry.id)) {
          loaded = cache.get(entry.id)!;
        } else {
          status.textContent = 'loading voice…';
          loaded = await loadVoice(entry, (frac, label) => {
            status.textContent = `${label}${frac ? ` — ${Math.round(frac * 100)}%` : ''}`;
          });
          cache.set(entry.id, loaded);
          status.textContent = `ready (${loaded.provider})`;
        }
        status.textContent = 'synthesizing…';
        const blob = await synthesize(loaded, text, {
          lengthScale: 1 / +speed.value, // higher speed = shorter duration
          volume: +volume.value,
          noiseScale: +noise.value,
          noiseW: +noisew.value,
        });
        const u = URL.createObjectURL(blob);
        player.src = u;
        download.href = u;
        download.download = `${entry.id}.wav`;
        result.classList.remove('hidden');
        status.textContent = `done (${loaded.provider})`;
        player.play().catch(() => {});
      } catch (err) {
        status.textContent = (err as Error).message || 'failed';
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</Base>
