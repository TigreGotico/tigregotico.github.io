---
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import { getEntry, render } from 'astro:content';
import { site } from '../../data/site';
import { pageEntryId, localePath, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}
const locale: Locale = Astro.props.locale ?? 'en';
const S = {
  en: {
    eyebrow: 'Engagements',
    title: 'Services',
    cta: 'Ready to scope an engagement?',
    contact: 'Contact us',
    sample:
      'This site is a live sample of our static web-building: prerendered pages, no server to run, no database to keep. The palette switcher in the header is part of it — swap the color scheme and it persists, all in the browser.',
  },
  pt: {
    eyebrow: 'Contratos',
    title: 'Serviços',
    cta: 'Pronto para definir um projeto?',
    contact: 'Contacte-nos',
    sample:
      'Este sítio é uma amostra viva do nosso trabalho web estático: páginas pré-geradas, sem servidor para gerir, sem base de dados para manter. O seletor de paleta no cabeçalho faz parte da demonstração — troque o esquema de cores e a escolha persiste, tudo no navegador.',
  },
  es: {
    "eyebrow": "Contratos",
    "title": "Servicios",
    "cta": "¿Listo para definir un proyecto?",
    "contact": "Contáctenos",
    "sample": "Este sitio es una muestra viva de nuestro trabajo web estático: páginas pregeneradas, sin servidor que gestionar, sin base de datos que mantener. El selector de paleta en la cabecera forma parte de la demostración: cambie el esquema de colores y su elección persiste, todo en el navegador."
  },
  de: {
    "eyebrow": "Aufträge",
    "title": "Leistungen",
    "cta": "Bereit, ein Projekt zu umreißen?",
    "contact": "Kontaktieren Sie uns",
    "sample": "Diese Website ist ein lebendiges Beispiel unserer statischen Webentwicklung: vorgerenderte Seiten, kein Server, der betrieben werden muss, keine Datenbank, die gepflegt werden muss. Der Palettenumschalter in der Kopfzeile gehört dazu — wechseln Sie das Farbschema, und Ihre Wahl bleibt erhalten, alles im Browser."
  },
  nl: {
    "eyebrow": "Opdrachten",
    "title": "Diensten",
    "cta": "Klaar om een project af te bakenen?",
    "contact": "Neem contact op",
    "sample": "Deze site is een levend voorbeeld van ons statische webwerk: vooraf gegenereerde pagina's, geen server om te draaien, geen database om te onderhouden. De paletwisselaar in de kopregel maakt er deel van uit — wissel het kleurenschema en uw keuze blijft behouden, allemaal in de browser."
  },
  fr: {
    "eyebrow": "Missions",
    "title": "Services",
    "cta": "Prêt à définir un projet ?",
    "contact": "Contactez-nous",
    "sample": "Ce site est un échantillon vivant de notre travail web statique : des pages pré-générées, aucun serveur à exécuter, aucune base de données à maintenir. Le sélecteur de palette dans l'en-tête en fait partie — changez le jeu de couleurs et votre choix persiste, le tout dans le navigateur."
  },
  it: {
    "eyebrow": "Incarichi",
    "title": "Servizi",
    "cta": "Pronto a definire un progetto?",
    "contact": "Contattaci",
    "sample": "Questo sito è un esempio vivo del nostro sviluppo web statico: pagine pre-generate, nessun server da gestire, nessun database da mantenere. Il selettore di palette nell'intestazione ne fa parte — cambia lo schema di colori e la scelta persiste, tutto nel browser."
  },
  ru: {
    "eyebrow": "Проекты",
    "title": "Услуги",
    "cta": "Готовы обсудить проект?",
    "contact": "Свяжитесь с нами",
    "sample": "Этот сайт — живой пример нашей статической веб-разработки: предварительно отрендеренные страницы, никакого сервера для поддержки, никакой базы данных. Переключатель палитры в шапке — часть демонстрации: смените цветовую схему, и выбор сохранится, всё это в браузере."
  },
  ar: {
    "eyebrow": "التكليفات",
    "title": "الخدمات",
    "cta": "هل أنت مستعد لتحديد نطاق مشروع؟",
    "contact": "اتصل بنا",
    "sample": "هذا الموقع نموذج حي لعملنا في بناء الويب الثابت: صفحات مُولَّدة مسبقًا، بلا خادم يعمل، وبلا قاعدة بيانات تُصان. مبدّل لوحة الألوان في الترويسة جزء من ذلك — بدّل نظام الألوان وسيبقى اختيارك محفوظًا، كل ذلك داخل المتصفح."
  },
  fa: {
    "eyebrow": "همکاری‌ها",
    "title": "خدمات",
    "cta": "آماده‌اید دامنه یک پروژه را تعریف کنید؟",
    "contact": "با ما تماس بگیرید",
    "sample": "این وب‌سایت نمونه‌ای زنده از کار وب استاتیک ماست: صفحه‌های از پیش تولیدشده، بدون سروری برای اجرا و بدون پایگاه‌داده‌ای برای نگهداری. کلید تعویض پالت رنگ در سربرگ بخشی از آن است — طرح رنگ را عوض کنید و انتخاب شما ماندگار می‌شود، همه در مرورگر."
  },
  hi: {
    "eyebrow": "अनुबंध",
    "title": "सेवाएँ",
    "cta": "किसी अनुबंध की रूपरेखा बनाने के लिए तैयार हैं?",
    "contact": "हमसे संपर्क करें",
    "sample": "यह साइट हमारे स्थैतिक वेब-निर्माण का एक जीवंत नमूना है: पहले से रेंडर किए गए पृष्ठ, चलाने के लिए कोई सर्वर नहीं, बनाए रखने के लिए कोई डेटाबेस नहीं। हेडर में पैलेट स्विचर इसी का हिस्सा है — रंग योजना बदलें और वह बनी रहती है, सब कुछ ब्राउज़र में।"
  },
  zh: {
    "eyebrow": "合作方式",
    "title": "服务",
    "cta": "准备好规划一个合作项目了吗？",
    "contact": "联系我们",
    "sample": "本网站是我们静态网站构建的实时范例：预渲染页面，无需运行服务器，无需维护数据库。页眉中的配色切换器也是其中一部分——切换配色方案后设置会被保留，全部在浏览器中完成。"
  },
  ko: {
    "eyebrow": "프로젝트",
    "title": "서비스",
    "cta": "프로젝트 범위를 정할 준비가 되셨나요?",
    "contact": "문의하기",
    "sample": "이 사이트는 저희 정적 웹 제작의 살아있는 예시입니다. 사전 렌더링된 페이지로, 운영할 서버도, 유지할 데이터베이스도 없습니다. 헤더의 팔레트 전환기도 그 일부입니다 — 색상 구성을 바꾸면 그 선택이 유지되며, 모두 브라우저 안에서 이루어집니다."
  },
  ja: {
    "eyebrow": "業務",
    "title": "サービス",
    "cta": "プロジェクトの範囲を検討する準備はできましたか？",
    "contact": "お問い合わせ",
    "sample": "このサイトは、私たちの静的ウェブ構築の実物サンプルです。事前生成されたページで、運用するサーバーも、維持するデータベースもありません。ヘッダーにあるパレット切り替えもその一部です。配色を変えるとその選択が保持され、すべてブラウザ内で完結します。"
  }
}[locale];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (href: string) => `${base}${localePath(locale, href)}`;
const page = await getEntry('pages', pageEntryId(locale, 'services'));
const { Content } = await render(page!);
---

<Base title={page!.data.title} description={page!.data.description} locale={locale}>
  <PageHeader eyebrow={S.eyebrow} title={S.title} lead={page!.data.description} />

  <article class="prose-content max-w-3xl">
    <Content />
  </article>

  <div class="mt-12 flex flex-wrap items-center gap-3 rounded-2xl border border-border bg-surface p-6" style="box-shadow: var(--shadow-elevate);">
    <p class="w-full display-3 text-lg">{S.cta}</p>
    <a class="btn-primary" href={`${link('/contact')}/`}>{S.contact}</a>
    <a class="btn-ghost" href={`mailto:${site.email}`}>{site.email}</a>
  </div>

  <p class="mt-6 max-w-3xl text-sm text-muted">{S.sample}</p>
</Base>
